generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DepartmentStatus {
  active
  inactive
}

enum EmployeeStatus {
  active
  on_leave
  terminated
}

enum EducationLevel {
  under_diploma
  diploma
  associate
  bachelor
  master
  phd
}

enum MaritalStatus {
  single
  married
}

enum Gender {
  male
  female
}

enum SalaryPeriod {
  monthly
  weekly
  daily
}

enum ContractType {
  permanent
  temporary
  fixed_task
}

// Why an employee's cooperation ended (2026-10-14). Set only through
// EmployeesService.terminate(), together with a free-text reason.
enum EmployeeExitType {
  resigned
  fired
  contract_ended
  retired
  other
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum SupplierStatus {
  active
  inactive
  blacklisted
}

// Customer type list confirmed by the user (database_plan.txt had it as
// "proposed, confirm the list").
enum CustomerType {
  retail
  wholesale
  distributor
  other
}

// database_plan.txt lists Item.status as "proposed: active / inactive".
enum ItemStatus {
  active
  inactive
}

// Inventory build plan I1 (2026-10-08), B2: the company produces what it
// sells and also tracks raw materials/packaging as stock. FINISHED_GOOD is
// the only kind Sales pickers show; RAW_MATERIAL/PACKAGING are consumed by
// production (tracked as stock, never sellable). Every existing Item row
// defaults to FINISHED_GOOD (safe, additive).
enum ItemKind {
  FINISHED_GOOD
  RAW_MATERIAL
  PACKAGING
}

// PENDING_APPROVAL (workflow engine, 2026-10-14): a purchase a workflow rule
// says needs approval sits here instead of CONFIRMED until its approval
// request is approved (→ CONFIRMED), rejected/withdrawn (→ DRAFT) or the
// purchase is cancelled. Only PurchasesService moves it in or out.
enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  RECEIVED
  CLOSED
  CANCELLED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Shared with Sales once that module exists — see database_plan.txt
// ("PAYMENT_METHOD and PAYMENT_STATUS are reused from Purchases rather than
// redefined"). Left unprefixed for that reason.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Shared with Sales once that module exists — same reasoning as PaymentMethod.
enum DocumentType {
  INVOICE
  CONTRACT
  DELIVERY_NOTE
  WARRANTY
  RECEIPT
  OTHER
}

// Distinguishes purchases entered as they happen from old paper records
// being digitized after the fact — both live in the same Purchase table
// (never a separate HistoricalPurchase table) so reporting/analytics can
// span all years. See PurchasesService for what HISTORICAL_IMPORT relaxes.
enum PurchaseSourceType {
  OPERATIONAL
  HISTORICAL_IMPORT
}

// APPROVED/REJECTED are still set by an edit today. Superseded direction
// (owner, 2026-10-14): approvals move to the workflow engine
// (backend/src/workflow/) — purchase requests get gated by it in a later
// batch; the old "no multi-level approval chain" note no longer applies.
//
// PARTIALLY_PURCHASED/COMPLETED are the exception — those two are never set
// by a user edit. They are recomputed automatically by
// PurchaseRequestsService.recomputeStatus() whenever a linked Purchase is
// created, edited, or removed (see PurchasesService), based on how much of
// each requested item has actually been purchased. A request still in
// DRAFT/SUBMITTED, or already REJECTED/CANCELLED, is never touched by that
// recompute — only APPROVED ⇄ PARTIALLY_PURCHASED ⇄ COMPLETED.
enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_PURCHASED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PurchaseRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Department {
  id                 Int               @id @default(autoincrement())
  code               String            @unique
  name               String
  status             DepartmentStatus  @default(active)
  note               String?
  employees          Employee[]
  // Purchases this department requested (Purchase.requesterDepartment) —
  // see the Purchase model for why there is no separate requester-employee
  // relation.
  requestedPurchases Purchase[]
  // Purchase Requests this department raised (PurchaseRequest.requesterDepartment).
  purchaseRequests   PurchaseRequest[]

  @@map("departments")
}

model Employee {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  departmentId  Int            @map("department_id")
  department    Department     @relation(fields: [departmentId], references: [id])
  position      String?
  nationalId    String?        @unique @map("national_id")
  mobilePhone   String?        @map("mobile_phone")
  landlinePhone String?        @map("landline_phone")
  birthDate     DateTime?      @map("birth_date")
  hireDate      DateTime?      @map("hire_date")
  email         String?
  status        EmployeeStatus @default(active)
  note          String?
  photoPath     String?        @map("photo_path")

  // --- اطلاعات هویتی و خانوادگی (identity & family — all optional) ---
  fatherName             String?        @map("father_name")
  birthCertificateNumber String?        @map("birth_certificate_number")
  maritalStatus          MaritalStatus? @map("marital_status")
  childrenCount          Int?           @map("children_count")
  gender                 Gender?

  // --- تحصیلات (education) ---
  educationLevel    EducationLevel? @map("education_level")
  // Only meaningful when educationLevel = under_diploma ("زیر دیپلم") —
  // which class/grade the employee completed, and what field/trade they
  // studied. Neither is enforced as an independent column rule — see
  // employee.dto.ts for the cross-field requirement.
  belowDiplomaGrade String?         @map("below_diploma_grade")
  fieldOfStudy      String?         @map("field_of_study")

  // --- اطلاعات استخدام و قرارداد (employment & contract) ---
  workLocation         String?       @map("work_location")
  workingHours         String?       @map("working_hours")
  // LEGACY (2026-10-14): the single-contract columns contract_type /
  // contract_start_date / contract_end_date / contract_document_path were
  // replaced by the employee_contracts history (EmployeeContract) — their data
  // was copied there by the migration and the app no longer reads or writes
  // them. Dropping them is a separate future migration that needs explicit
  // confirmation.
  contractType         ContractType? @map("contract_type")
  contractStartDate    DateTime?     @map("contract_start_date")
  contractEndDate      DateTime?     @map("contract_end_date")
  // Money — stored as a fixed-point Decimal, never a float. The pay period
  // (ماهانه/هفتگی/روزانه) is a separate column, not baked into the field
  // name, since the company pays some roles by the day or week.
  salaryAmount         Decimal?      @map("salary_amount") @db.Decimal(12, 2)
  salaryPeriod         SalaryPeriod? @map("salary_period")
  // Free text — covers a plain account number, a card number, or a Sheba/IBAN,
  // whichever the company collects. Not validated against a specific format.
  bankAccountNumber    String?       @map("bank_account_number")
  // A scanned/photographed contract document (PDF or image), stored on disk
  // the same way photoPath is — only the relative URL is kept here, set
  // through its own upload endpoint, not through create/update.
  contractDocumentPath String?       @map("contract_document_path")

  // --- اطلاعات تماس و سایر (contact & other) ---
  address String?

  // --- پایان همکاری (termination, 2026-10-14) ---
  // status = terminated is only ever set by EmployeesService.terminate(),
  // which requires all three. Cleared by reactivate(). Employees terminated
  // before this existed keep them null (reason "not recorded").
  terminationDate   DateTime?         @map("termination_date")
  terminationType   EmployeeExitType? @map("termination_type")
  terminationReason String?           @map("termination_reason")

  // Contract history — the current contract is the latest one; tenure is
  // computed from these periods (employees/employee-tenure.ts).
  contracts EmployeeContract[]

  // Purchases this employee bought (Purchase.buyerEmployee).
  purchasesAsBuyer            Purchase[]
  // Purchase Requests this employee personally raised (PurchaseRequest.requestedByEmployee) — optional, distinct from purchasesAsBuyer.
  purchaseRequestsAsRequester PurchaseRequest[]
  // Sales orders this employee is the salesperson on (SalesOrder.salespersonEmployee).
  salesOrdersAsSalesperson    SalesOrder[]
  // Production outputs this employee (or production line lead) produced —
  // ProductionOutput.producedByEmployee, optional, SetNull (I5, §5.11).
  productionOutputsProduced   ProductionOutput[]

  @@map("employees")
}

// One contract period of an employee (2026-10-14). A contract is typically
// monthly first, then yearly and so on — each extension is a new row, so the
// whole history is kept. endDate is null only for a permanent contract.
// Periods of one employee never overlap (checked in EmployeesService).
model EmployeeContract {
  id           Int          @id @default(autoincrement())
  employeeId   Int          @map("employee_id")
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contractType ContractType @map("contract_type")
  startDate    DateTime     @map("start_date")
  endDate      DateTime?    @map("end_date")
  note         String?
  // Scanned contract (PDF/image) — uploaded through its own endpoint.
  documentPath String?      @map("document_path")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@map("employee_contracts")
}

// Master data: a company the business buys from.
enum SupplierKind {
  INDIVIDUAL
  ORGANIZATION
}

model SupplierBankAccount {
  id                Int      @id @default(autoincrement())
  supplierId        Int      @map("supplier_id")
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  bankName          String?  @map("bank_name")
  accountNumber     String?  @map("account_number")
  // Stored normalized: "IR" + 24 digits (legacy copies are kept as typed).
  shebaNumber       String?  @map("sheba_number")
  accountHolderName String?  @map("account_holder_name")
  // At most one default per supplier — enforced by the service.
  isDefault         Boolean  @default(false) @map("is_default")
  isActive          Boolean  @default(true) @map("is_active")
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([supplierId])
  @@map("supplier_bank_accounts")
}

model Supplier {
  id                 Int                    @id @default(autoincrement())
  code               String                 @unique
  name               String
  // شناسه ملی — the supplier's national/legal registration id. Optional
  // (not every supplier record will have it on hand yet) but unique when
  // provided, same treatment as Employee.nationalId.
  nationalId         String?                @unique @map("national_id")
  phone              String?
  email              String?
  address            String?
  // --- اطلاعات بانکی (bank details — three separate fields, not one blob) ---
  bankName           String?                @map("bank_name")
  bankAccountNumber  String?                @map("bank_account_number")
  bankShebaNumber    String?                @map("bank_sheba_number")
  status             SupplierStatus         @default(active)
  note               String?
  // Party master data (2026-10-13). `nationalId` is the کد ملی (INDIVIDUAL) or
  // شناسه ملی (ORGANIZATION) depending on supplierKind; `address` is نشانی ۱.
  // The three bank_* columns above are legacy — superseded by
  // supplier_bank_accounts (copied by the migration, no longer read/written).
  supplierKind       SupplierKind?          @map("supplier_kind")
  title              String?
  economicCode       String?                @map("economic_code")
  registrationNumber String?                @map("registration_number")
  phone2             String?                @map("phone_2")
  mobile             String?
  fax                String?
  telex              String?
  website            String?
  address2           String?                @map("address_2")
  province           String?
  city               String?
  postalCode         String?                @map("postal_code")
  country            String?
  cityCode           String?                @map("city_code")
  locationNumber     String?                @map("location_number")
  locationName       String?                @map("location_name")
  taxOfficeProvince  String?                @map("tax_office_province")
  taxOfficeCity      String?                @map("tax_office_city")
  bankAccounts       SupplierBankAccount[]
  // What we buy from this supplier: its purchase types (drives the auto-fill on
  // purchase / request forms) and a free-text list of goods (never FK'd to Item).
  purchaseTypes      SupplierPurchaseType[]
  goods              SupplierGood[]
  purchases          Purchase[]
  // I5 (build plan §5.5): raw-material/packaging receipts from this supplier.
  goodsReceipts      GoodsReceipt[]
  // I8 (build plan §5.8): returns of stock back to this supplier.
  goodsReturns       GoodsReturn[]

  @@map("suppliers")
}

enum CustomerKind {
  INDIVIDUAL
  ORGANIZATION
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum CustomerAddressType {
  BILLING
  DELIVERY
  OTHER
}

enum CustomerNoteType {
  GENERAL
  WARNING
  DELIVERY
  FINANCE
}

enum CustomerDocumentType {
  BUSINESS_LICENSE
  REGISTRATION
  IDENTITY
  CONTRACT
  TAX
  SCANNED_PAPER_RECORD
  OTHER
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Customer classification (replaces the old CustomerType enum — seeded with
// the same four values/labels by the add_customer_module migration).
model CustomerGroup {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  nameEn    String     @map("name_en")
  nameFa    String     @map("name_fa")
  isActive  Boolean    @default(true) @map("is_active")
  sortOrder Int        @default(1) @map("sort_order")
  customers Customer[]

  @@map("customer_groups")
}

// Sales territory / region — optional on Customer.
model Territory {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  nameEn    String     @map("name_en")
  nameFa    String     @map("name_fa")
  isActive  Boolean    @default(true) @map("is_active")
  sortOrder Int        @default(1) @map("sort_order")
  customers Customer[]

  @@map("territories")
}

// Payment terms a customer may be granted (نقد / ۷ / ۱۵ / ۳۰ روزه seeded).
// Not assigned by default — a new customer is cash-only until someone with
// customers.finance sets a policy (business decision 6).
model PaymentTerm {
  id                Int                        @id @default(autoincrement())
  code              String                     @unique
  nameEn            String                     @map("name_en")
  nameFa            String                     @map("name_fa")
  dueDays           Int                        @default(0) @map("due_days")
  isActive          Boolean                    @default(true) @map("is_active")
  sortOrder         Int                        @default(1) @map("sort_order")
  financialProfiles CustomerFinancialProfile[]
  salesOrders       SalesOrder[]

  @@map("payment_terms")
}

// مشتری — governed customer master data (see CustomersService).
// customerNumber ("CUS-000001") is
// system-generated, same placeholder-then-fix pattern as
// Purchase.purchaseNumber. legacyCode is the old user-typed `code` column,
// renamed — searchable, unique, but never "the" customer number.
model Customer {
  id                 Int            @id @default(autoincrement())
  customerNumber     String         @unique @map("customer_number")
  customerKind       CustomerKind   @map("customer_kind")
  name               String
  legalName          String?        @map("legal_name")
  // Sensitive — never written to audit details/changes as a value.
  nationalId         String?        @unique @map("national_id")
  economicCode       String?        @map("economic_code")
  legacyCode         String?        @unique @map("legacy_code")
  phone              String
  email              String?
  // Party master data (2026-10-13). `title` is a prefix such as «شرکت»/«آقای».
  // `nationalId` above is the کد ملی (10 digits) for INDIVIDUAL and the
  // شناسه ملی (11 digits) for ORGANIZATION — one column, labelled by kind.
  title              String?
  registrationNumber String?        @map("registration_number")
  phone2             String?        @map("phone_2")
  mobile             String?
  fax                String?
  telex              String?
  website            String?
  taxOfficeProvince  String?        @map("tax_office_province")
  taxOfficeCity      String?        @map("tax_office_city")
  customerGroupId    Int            @map("customer_group_id")
  customerGroup      CustomerGroup  @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)
  territoryId        Int?           @map("territory_id")
  territory          Territory?     @relation(fields: [territoryId], references: [id])
  status             CustomerStatus @default(ACTIVE)
  statusReason       String?        @map("status_reason")
  statusChangedAt    DateTime?      @map("status_changed_at")
  createdByUserId    Int?           @map("created_by_user_id")
  createdByUser      User?          @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at")

  // --- Legacy columns (pre-2026-10-06 flat customer record) ---
  // Kept in place, untouched, as a safety net: their data was copied into
  // customerGroup / CustomerAddress / CustomerNote by the
  // add_customer_module migration. Never read or written by the app.
  // Dropping them is a separate future migration ("Migration B") that needs
  // fresh explicit confirmation. customer_type was made nullable so new
  // customers (which don't have one) can be inserted.
  legacyCustomerType CustomerType? @map("customer_type")
  legacyAddress      String?       @map("address")
  legacyNote         String?       @map("note")

  contacts           CustomerContact[]
  addresses          CustomerAddress[]
  bankAccounts       CustomerBankAccount[]
  financialProfile   CustomerFinancialProfile?
  notes              CustomerNote[]
  documents          CustomerDocument[]
  complaints         CustomerComplaint[]
  salesOrders        SalesOrder[]
  deliveries         Delivery[]
  salesInvoices      SalesInvoice[]
  customerPayments   CustomerPayment[]
  paymentAllocations PaymentAllocation[]
  salesReturns       SalesReturn[]
  creditNotes        CreditNote[]

  @@index([customerGroupId])
  @@index([status])
  @@index([phone])
  @@map("customers")
}

model CustomerContact {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name       String
  roleTitle  String?  @map("role_title")
  mobile     String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  isActive   Boolean  @default(true) @map("is_active")
  note       String?

  @@index([customerId])
  @@map("customer_contacts")
}

model CustomerBankAccount {
  id                Int      @id @default(autoincrement())
  customerId        Int      @map("customer_id")
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bankName          String?  @map("bank_name")
  accountNumber     String?  @map("account_number")
  // Stored normalized: "IR" + 24 digits.
  shebaNumber       String?  @map("sheba_number")
  accountHolderName String?  @map("account_holder_name")
  // At most one default per customer — enforced by the service.
  isDefault         Boolean  @default(false) @map("is_default")
  isActive          Boolean  @default(true) @map("is_active")
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("customer_bank_accounts")
}

model CustomerAddress {
  id                   Int                 @id @default(autoincrement())
  customerId           Int                 @map("customer_id")
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  addressType          CustomerAddressType @map("address_type")
  label                String?
  province             String?
  city                 String?
  addressLine          String              @map("address_line")
  postalCode           String?             @map("postal_code")
  // null country = ایران. Free text filled by users (2026-10-13).
  country              String?
  cityCode             String?             @map("city_code")
  locationNumber       String?             @map("location_number")
  locationName         String?             @map("location_name")
  phone                String?
  deliveryInstructions String?             @map("delivery_instructions")
  // At most one default per (customer, addressType) — enforced by
  // CustomerAddressesService, not a DB constraint.
  isDefault            Boolean             @default(false) @map("is_default")
  isActive             Boolean             @default(true) @map("is_active")
  // Sales orders delivering here (live ref, SetNull — orders keep a text snapshot).
  salesOrders          SalesOrder[]

  @@index([customerId])
  @@map("customer_addresses")
}

// Credit/payment policy — one row per customer, created empty with the
// customer. Edited only with customers.finance. No balance here: balances
// belong to the future Sales/finance modules.
model CustomerFinancialProfile {
  id                     Int            @id @default(autoincrement())
  customerId             Int            @unique @map("customer_id")
  customer               Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentTermId          Int?           @map("payment_term_id")
  paymentTerm            PaymentTerm?   @relation(fields: [paymentTermId], references: [id])
  preferredPaymentMethod PaymentMethod? @map("preferred_payment_method")
  creditLimit            Decimal?       @map("credit_limit") @db.Decimal(15, 0)
  creditHold             Boolean        @default(false) @map("credit_hold")
  creditHoldReason       String?        @map("credit_hold_reason")
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at")

  @@map("customer_financial_profiles")
}

model CustomerNote {
  id              Int              @id @default(autoincrement())
  customerId      Int              @map("customer_id")
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  noteType        CustomerNoteType @default(GENERAL) @map("note_type")
  body            String
  isPinned        Boolean          @default(false) @map("is_pinned")
  createdByUserId Int?             @map("created_by_user_id")
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_notes")
}

model CustomerDocument {
  id               Int                  @id @default(autoincrement())
  customerId       Int                  @map("customer_id")
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  documentType     CustomerDocumentType @map("document_type")
  documentNumber   String?              @map("document_number")
  date             DateTime?
  expiresAt        DateTime?            @map("expires_at")
  // Set by its own upload endpoint (metadata first, file second — same as
  // PurchaseDocument.filePath). Served only via the guarded
  // /uploads/customers/:filename route.
  filePath         String?              @map("file_path")
  note             String?
  uploadedByUserId Int?                 @map("uploaded_by_user_id")
  uploadedByUser   User?                @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_documents")
}

// Minimal complaint/issue register (business decision 8). No linked
// transaction — there is no Sales module yet.
model CustomerComplaint {
  id              Int               @id @default(autoincrement())
  customerId      Int               @map("customer_id")
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  date            DateTime
  category        String
  description     String
  severity        ComplaintSeverity @default(MEDIUM)
  status          ComplaintStatus   @default(OPEN)
  resolution      String?
  ownerUserId     Int?              @map("owner_user_id")
  ownerUser       User?             @relation("CustomerComplaintOwner", fields: [ownerUserId], references: [id])
  createdByUserId Int?              @map("created_by_user_id")
  createdByUser   User?             @relation("CustomerComplaintCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("customer_complaints")
}

// Master data shared by Purchase Item (and, later, Sales Item) — see
// database_plan.txt's Unit section.
model Unit {
  id                   Int                   @id @default(autoincrement())
  code                 String                @unique
  nameEn               String                @map("name_en")
  nameFa               String                @map("name_fa")
  isActive             Boolean               @default(true) @map("is_active")
  sortOrder            Int                   @default(1) @map("sort_order")
  purchaseItems        PurchaseItem[]
  purchaseRequestItems PurchaseRequestItem[]
  items                Item[]               @relation("ItemUnit")
  secondaryItems       Item[]               @relation("ItemSecondaryUnit")
  salesOrderItems      SalesOrderItem[]

  @@map("units")
}

// The company's own details (نام، کدها، نشانی، تلفن) printed on invoices and
// other documents. Exactly one row (id = 1, enforced by a CHECK in the
// migration); owned by the Company module. Printed live — documents do not
// copy it. No relation to User or Employee (hard rule 1).
model CompanyProfile {
  id                 Int      @id @default(1)
  legalName          String   @default("") @map("legal_name")
  brandName          String?  @map("brand_name")
  companyType        String?  @map("company_type")
  nationalId         String?  @map("national_id")
  economicCode       String?  @map("economic_code")
  registrationNumber String?  @map("registration_number")
  province           String?
  city               String?
  postalCode         String?  @map("postal_code")
  address            String?
  phone1             String?  @map("phone_1")
  phone2             String?  @map("phone_2")
  fax                String?
  email              String?
  website            String?
  documentFooter     String?  @map("document_footer")
  logoPath           String?  @map("logo_path")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}

// Master data — Item Category (دسته‌بندی کالا). Same shape as Unit /
// PurchaseType, see database_plan.txt's Item Category section.
model ItemCategory {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  nameEn    String  @map("name_en")
  nameFa    String  @map("name_fa")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(1) @map("sort_order")
  items     Item[]

  @@map("item_categories")
}

// Master data — Item (کالا). Item means "things the company produces/sells";
// it is NOT a universal purchasing catalog, which is why PurchaseItem /
// PurchaseRequestItem keep a free-text name and never reference this table.
// Will be referenced by SalesItem once Sales exists.
model Item {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique
  name                  String
  categoryId            Int                    @map("category_id")
  category              ItemCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitId                Int                    @map("unit_id")
  unit                  Unit                   @relation("ItemUnit", fields: [unitId], references: [id], onDelete: Restrict)
  // Secondary unit (واحد فرعی), optional: a second way to enter/show quantities
  // (e.g. «کارتن»). `unit` stays the ONE stock unit every quantity and the
  // stock card are held in; secondaryUnitFactor = how many of `unit` make ONE
  // secondary unit (carton = 12 pieces → 12). Both set or both null. Master
  // data only for now — no document or stock row converts with it yet.
  secondaryUnitId       Int?                   @map("secondary_unit_id")
  secondaryUnit         Unit?                  @relation("ItemSecondaryUnit", fields: [secondaryUnitId], references: [id], onDelete: Restrict)
  secondaryUnitFactor   Decimal?               @map("secondary_unit_factor") @db.Decimal(14, 6)
  description           String?
  status                ItemStatus             @default(active)
  // Inventory build plan I1, B2: which stock role this item plays. Sales
  // pickers filter to FINISHED_GOOD only — raw materials/packaging are
  // never sellable.
  itemKind              ItemKind               @default(FINISHED_GOOD) @map("item_kind")
  note                  String?
  // Default selling price (Rial, same precision as Purchase.totalAmount).
  // Optional — an item without one is priced manually on each sales line
  // (Sales batches, later). Only a default; never a historical fact.
  sellingPrice          Decimal?               @map("selling_price") @db.Decimal(15, 0)
  // Inventory (stock ledger) — all Restrict: an item with stock history
  // can't be deleted, only deactivated.
  stockBalances         StockBalance[]
  stockMovements        StockMovement[]
  stockAdjustmentItems  StockAdjustmentItem[]
  // I3 (build plan §5.3, B14): per item+location min/reorder/max thresholds.
  itemStockLevels       ItemStockLevel[]
  salesOrderItems       SalesOrderItem[]
  deliveryItems         DeliveryItem[]
  salesInvoiceItems     SalesInvoiceItem[]
  salesReturnItems      SalesReturnItem[]
  // I4 (build plan §5.4): batch/expiry config + ledger — Cascade on the
  // settings row only (pure config; an item with only a settings row must
  // stay deletable), Restrict on actual batch history like every other
  // stock table.
  inventoryItemSetting  InventoryItemSetting?
  stockBatches          StockBatch[]
  // I5 (build plan §5.5/§5.11): inbound document lines — Restrict.
  goodsReceiptItems     GoodsReceiptItem[]
  productionOutputItems ProductionOutputItem[]
  // I6 (build plan §5.6): stock-count lines for this item — Restrict.
  stockCountItems       StockCountItem[]
  // I8 (build plan §5.8): goods-return lines for this item — Restrict.
  goodsReturnItems      GoodsReturnItem[]

  @@index([categoryId])
  @@index([unitId])
  @@map("items")
}

// Master data — see database_plan.txt's Purchase Type section for the seed
// list (raw_material, food_ingredient, packaging, ...).
model PurchaseType {
  id               Int                    @id @default(autoincrement())
  code             String                 @unique
  nameEn           String                 @map("name_en")
  nameFa           String                 @map("name_fa")
  isActive         Boolean                @default(true) @map("is_active")
  sortOrder        Int                    @default(0) @map("sort_order")
  purchases        Purchase[]
  purchaseRequests PurchaseRequest[]
  suppliers        SupplierPurchaseType[]

  @@map("purchase_types")
}

// Optional business event preceding a Purchase — "optional" is the whole
// point (see the Purchase module architecture note): plenty of purchases
// are urgent, direct, or recurring and never go through a formal request.
// Approval: see the PurchaseRequestStatus note — moving to the workflow engine.
model PurchaseRequest {
  id            Int      @id @default(autoincrement())
  // System-generated — "REQ-000001" — same placeholder-then-fix pattern as
  // Purchase.purchaseNumber.
  requestNumber String   @unique @map("request_number")
  requestDate   DateTime @map("request_date")

  // Required (business decision 2026-10-06) — carried into the Purchase
  // form as its default purchase type when a Purchase is created from this
  // request. Same relation shape as Purchase.purchaseType.
  purchaseTypeId Int          @map("purchase_type_id")
  purchaseType   PurchaseType @relation(fields: [purchaseTypeId], references: [id])

  requesterDepartmentId Int        @map("requester_department_id")
  requesterDepartment   Department @relation(fields: [requesterDepartmentId], references: [id])
  // The specific person who asked for it, if known — optional because a
  // request can also just come from a department in general.
  requestedByEmployeeId Int?       @map("requested_by_employee_id")
  requestedByEmployee   Employee?  @relation(fields: [requestedByEmployeeId], references: [id])

  status   PurchaseRequestStatus   @default(DRAFT)
  priority PurchaseRequestPriority @default(NORMAL)
  note     String?

  // Which system account entered this record — data-entry provenance, not
  // "who asked for it" (that's requestedByEmployee).
  createdByUserId Int?     @map("created_by_user_id")
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items     PurchaseRequestItem[]
  // Zero or more Purchases may originate from this request — kept
  // one-to-many (not one-to-one) so a request can later be split across
  // partial/consolidated purchases without a schema change.
  purchases Purchase[]

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                Int             @id @default(autoincrement())
  purchaseRequestId Int             @map("purchase_request_id")
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  // Plain text, same reasoning as PurchaseItem.name — not linked to an Item record.
  name              String
  quantity          Decimal         @db.Decimal(12, 2)
  unitId            Int             @map("unit_id")
  unit              Unit            @relation(fields: [unitId], references: [id])
  requiredDate      DateTime?       @map("required_date")
  note              String?

  // Zero or more PurchaseItem rows created to (partially or fully) fulfill
  // this requested item — see PurchaseItem.purchaseRequestItem. Purchased /
  // remaining quantity is always derived from these at read time
  // (PurchaseRequestsService), never stored on this row.
  purchaseItems PurchaseItem[]

  @@map("purchase_request_items")
}

model Purchase {
  id             Int          @id @default(autoincrement())
  // System-generated sequential number — "PUR-000001" — assigned right after
  // the row is created (see PurchasesService.create(), same
  // placeholder-then-fix pattern used for Employee.code). Never entered by
  // the user, and not the same thing as a supplier's own invoice/document
  // number — that's recorded per-document on PurchaseDocument instead.
  purchaseNumber String       @unique @map("purchase_number")
  purchaseDate   DateTime     @map("purchase_date")
  purchaseTypeId Int          @map("purchase_type_id")
  purchaseType   PurchaseType @relation(fields: [purchaseTypeId], references: [id])

  // The optional Purchase Request this purchase originated from — most
  // purchases (urgent, direct, recurring) will have none at all.
  purchaseRequestId Int?             @map("purchase_request_id")
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])

  // Distinguishes a purchase entered as it happens from an old paper
  // record being digitized after the fact. Both rows live in this same
  // table — see PurchaseSourceType.
  sourceType PurchaseSourceType @default(OPERATIONAL) @map("source_type")

  // Requester Department only. database_plan.txt originally modeled the
  // requester as two nullable FKs (Employee OR Department, exactly one
  // set) — this was explicitly simplified to Department-only for this
  // implementation; Requester Employee is intentionally not modeled.
  // Nullable — not every historical paper record names a department, and
  // PurchasesService refuses to fabricate one just to satisfy this column
  // (see the HISTORICAL_IMPORT handling there). Still required for a new
  // OPERATIONAL purchase — enforced in purchase.dto.ts, not here.
  requesterDepartmentId Int?        @map("requester_department_id")
  requesterDepartment   Department? @relation(fields: [requesterDepartmentId], references: [id])
  // The employee who actually made the purchase — distinct from the
  // requester department above. Nullable for the same historical-import
  // reason as requesterDepartmentId.
  buyerEmployeeId       Int?        @map("buyer_employee_id")
  buyerEmployee         Employee?   @relation(fields: [buyerEmployeeId], references: [id])
  supplierId            Int         @map("supplier_id")
  supplier              Supplier    @relation(fields: [supplierId], references: [id])

  status        PurchaseStatus        @default(DRAFT)
  // paymentStatus, totalAmount and paidAmount are all derived — never set
  // directly by the client — and recomputed by PurchasesService whenever
  // items or payments change. Persisted (not computed on every read) so the
  // purchase list can filter/sort/display them without re-summing items and
  // payments on every request.
  paymentStatus PurchasePaymentStatus @default(UNPAID) @map("payment_status")
  totalAmount   Decimal               @default(0) @map("total_amount") @db.Decimal(15, 0)
  paidAmount    Decimal               @default(0) @map("paid_amount") @db.Decimal(15, 0)
  note          String?
  createdAt     DateTime              @default(now()) @map("created_at")
  // Optimistic-locking token for PATCH /purchases/:id (the client sends back
  // the updatedAt it loaded; a mismatch is a 409). @default(now()) so the
  // column could be added to a table that already has rows.
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at")

  items     PurchaseItem[]
  payments  PurchasePayment[]
  documents PurchaseDocument[]
  returns   PurchaseReturn[]

  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int      @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  // Plain text by explicit instruction — NOT a link to an Item record. A
  // company can buy things (machinery, office supplies, ...) that aren't
  // among the products it produces/sells. See database_plan.txt.
  name       String
  quantity   Decimal  @db.Decimal(12, 2)
  unitId     Int      @map("unit_id")
  unit       Unit     @relation(fields: [unitId], references: [id])
  // Optional — some purchases (exceptions, gifts, items priced only as a
  // lump sum) don't have a meaningful per-unit price. Total Price below is
  // what's actually billed and is always required.
  unitPrice  Decimal? @map("unit_price") @db.Decimal(15, 0)
  // Stored independently — NOT derived or enforced as quantity × unitPrice.
  totalPrice Decimal  @map("total_price") @db.Decimal(15, 0)

  // The specific Purchase Request item this line fulfills, if any — most
  // Purchase items have none (a purchase created without an originating
  // request, or a free-form extra item added beyond what was requested).
  // This is the missing link that lets purchased/remaining quantity be
  // computed per request item, not just per whole request (see
  // Purchase.purchaseRequestId, which only links the request as a whole).
  purchaseRequestItemId Int?                 @map("purchase_request_item_id")
  purchaseRequestItem   PurchaseRequestItem? @relation(fields: [purchaseRequestItemId], references: [id])

  // Return-to-vendor lines recorded against this item (see PurchaseReturnItem).
  returnItems PurchaseReturnItem[]

  @@map("purchase_items")
}

model PurchasePayment {
  id                       Int           @id @default(autoincrement())
  purchaseId               Int           @map("purchase_id")
  purchase                 Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  amount                   Decimal       @db.Decimal(15, 0)
  paymentDate              DateTime      @map("payment_date")
  method                   PaymentMethod
  referenceNumber          String?       @map("reference_number")
  status                   PaymentStatus @default(PENDING)
  note                     String?
  // Transfer-receipt info (2026-10-13) — informational only. transactionTime
  // is "HH:MM" Tehran wall clock on paymentDate; the tracking code (کد پیگیری)
  // reuses referenceNumber.
  transactionTime          String?       @map("transaction_time")
  transactionType          String?       @map("transaction_type")
  depositId                String?       @map("deposit_id")
  withdrawalId             String?       @map("withdrawal_id")
  sourceAccount            String?       @map("source_account")
  destinationAccount       String?       @map("destination_account")
  destinationAccountHolder String?       @map("destination_account_holder")

  @@map("purchase_payments")
}

model PurchaseDocument {
  id             Int          @id @default(autoincrement())
  purchaseId     Int          @map("purchase_id")
  purchase       Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  // The supplier's own document number (invoice #, etc.) — distinct from
  // Purchase.purchaseNumber, which is this system's internal id.
  documentNumber String?      @map("document_number")
  documentType   DocumentType @map("document_type")
  date           DateTime
  // Uploaded separately from the create/update JSON body, same pattern as
  // Employee.photoPath / contractDocumentPath — set through its own upload
  // endpoint, null until a file is attached.
  filePath       String?      @map("file_path")
  note           String?

  @@map("purchase_documents")
}

// A Return-to-Vendor (RTV) record: goods from a Purchase sent back to the
// supplier, with the credit value of each returned line. Deliberately a
// plain historical record — no status lifecycle (same as PurchasePayment),
// and it does NOT change Purchase.totalAmount/paidAmount/paymentStatus:
// those keep meaning "what was originally billed/paid". How a return's
// credit is later applied (future payment offset, refund, ...) is
// intentionally not modeled yet. No Inventory/StockMovement effect either.
model PurchaseReturn {
  id           Int      @id @default(autoincrement())
  // System-generated — "RTN-000001" — same placeholder-then-fix pattern as
  // Purchase.purchaseNumber / PurchaseRequest.requestNumber.
  returnNumber String   @unique @map("return_number")
  // Restrict, same as PurchasePayment/PurchaseDocument — a Purchase with
  // recorded returns can't be deleted out from under them.
  purchaseId   Int      @map("purchase_id")
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  returnDate   DateTime @map("return_date")
  reason       String
  note         String?

  // Which system account entered this record — data-entry provenance, same
  // convention as PurchaseRequest.createdByUser.
  createdByUserId Int?     @map("created_by_user_id")
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items PurchaseReturnItem[]

  @@index([purchaseId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int            @map("purchase_return_id")
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  // The exact Purchase line being returned. Restrict — a purchase item with
  // returns recorded against it can't be deleted (this is also why editing
  // a Purchase's items is refused once it has returns — see
  // PurchasesService.update()).
  purchaseItemId   Int            @map("purchase_item_id")
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  // Same precision as PurchaseItem.quantity. Server-validated so the sum of
  // all returns for one purchase item never exceeds its original quantity.
  quantity         Decimal        @db.Decimal(12, 2)
  // Entered directly — NOT derived from quantity × unit price, same
  // philosophy as PurchaseItem.totalPrice. No arithmetic check constraint.
  creditAmount     Decimal        @map("credit_amount") @db.Decimal(15, 0)
  note             String?

  @@index([purchaseItemId])
  @@map("purchase_return_items")
}

// ---------------------------------------------------------------------------
// Document numbering (Sales batch 1, 2026-10-06)
// ---------------------------------------------------------------------------

// Gap-free per-type, per-Jalali-year counter. Incremented via an atomic
// UPDATE … SET last_value = last_value + 1 RETURNING inside the posting
// transaction — the row lock serializes concurrent posts; a rollback rolls
// the increment back too, so there are never gaps. Drafts carry no number.
// See backend/src/common/document-sequence.ts (the only writer).
model DocumentSequence {
  docType    String @map("doc_type") // "ADJ" today; "SO","DN","INV","RMA","CN","RCP" in later batches
  fiscalYear Int    @map("fiscal_year") // Jalali year, e.g. 1405
  lastValue  Int    @default(0) @map("last_value")

  @@id([docType, fiscalYear])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Inventory (stock ledger) — Sales batch 1, 2026-10-06.
// StockMovement/StockBalance are written ONLY by
// backend/src/inventory/stock-ledger.ts (applyMovements), always inside the
// same transaction as the source document (CLAUDE.md rule 10).
// ---------------------------------------------------------------------------

enum StockBucket {
  ON_HAND
  RESERVED
  QC
  // I8 (build plan §5.8, B9): physically held, not sellable, not released
  // back to QC — only leaves via a posted GoodsReturn to the supplier. Never
  // folded into "available" (onHand − reserved), same exclusion treatment as
  // QC/RESERVED.
  DAMAGED
}

enum StockMovementType {
  OPENING_BALANCE
  MANUAL_RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVE
  RELEASE
  DELIVERY_ISSUE
  RETURN_RECEIPT
  RETURN_RESTOCK
  RETURN_WRITE_OFF
  // I2 (build plan §5.2/§5.10): a posted WRITE_OFF stock-adjustment line.
  // ON_HAND out only for now (no DAMAGED bucket until I8/B9).
  WRITE_OFF
  // I5 (build plan §5.5/§5.10): a posted GoodsReceipt line — ON_HAND +q, or
  // QC +q when the receipt has inspectionRequired (B19).
  GOODS_RECEIPT
  // I5 (B19): QC → ON_HAND release of a goods-receipt line (two rows, same
  // reference: QC −r, ON_HAND +r).
  QC_RELEASE
  // I5 (build plan §5.11): a posted ProductionOutput line — ON_HAND +q.
  PRODUCTION_OUTPUT
  // I6 (build plan §5.6/§5.10/§6): a posted stock-count variance line.
  // COUNT_GAIN when countedQty > systemQty (ON_HAND +), COUNT_LOSS when
  // countedQty < systemQty (ON_HAND −).
  COUNT_GAIN
  COUNT_LOSS
  // I8 (build plan §5.8/§5.10, B9): a posted MARK_DAMAGED stock-adjustment
  // line — ON_HAND out, DAMAGED in (two rows, same reference).
  MARK_DAMAGED
  // I8: a sales-return line's "to damaged" disposition (SalesReturnItem
  // .damagedQty) — QC out, DAMAGED in (two rows, same reference).
  RETURN_TO_DAMAGED
  // I8: a posted GoodsReturn line — out of whichever bucket the line names
  // (ON_HAND | QC | DAMAGED), never more than one per row.
  SUPPLIER_RETURN
}

// What kind of source document a StockMovement came from. Deliberately NOT
// a foreign key (business decision 2026-10-06, resolving CLAUDE.md rule 9):
// referenceId/referenceLineId are the source header/line ids, enforced
// procedurally by stock-ledger.ts. A new source module adds an enum value,
// not a schema relation.
enum StockReferenceType {
  STOCK_ADJUSTMENT
  SALES_ORDER
  DELIVERY
  SALES_RETURN
  // I5 (build plan §5.5/§5.11).
  GOODS_RECEIPT
  PRODUCTION_OUTPUT
  // I6 (build plan §5.6).
  STOCK_COUNT
  // I8 (build plan §5.8).
  GOODS_RETURN
}

enum StockAdjustmentKind {
  OPENING
  RECEIPT
  CORRECTION
  // I2 (build plan §5.2, B10/B11): always a stock decrease. Always needs
  // inventory.approve (submit → approve), reasonCode required.
  WRITE_OFF
  // I4 (build plan §5.4/§5.4a, B23): converts an item from unbatched to
  // batch-tracked. Always needs inventory.approve (never self-approved),
  // but — unlike WRITE_OFF — reasonCode is NOT required (R6: approval-needed
  // and reasonCode-required are separate rules). Positive lines only, each
  // naming a batchNumber; posting is a special two-step transaction, not the
  // generic buildMovementRows() path — see StockAdjustmentsService.
  BATCH_CUTOVER
  // I8 (build plan §5.8, B9): found-damaged-on-the-shelf stock, unrelated to
  // any specific receipt (e.g. a stocktake finds broken units) — ON_HAND out,
  // DAMAGED in. Always negative lines (outbound-only, mirror of WRITE_OFF),
  // always needs inventory.approve (same tier as WRITE_OFF, B10), reasonCode
  // required. Posted via a dedicated two-row builder in
  // StockAdjustmentsService, not movementTypeForAdjustmentLine()'s generic
  // single-row path.
  MARK_DAMAGED
}

enum StockDocumentStatus {
  DRAFT
  // I2: a document whose kind/net quantity needs inventory.approve (B10) is
  // submitted here instead of posted directly. approve() moves it to
  // POSTED; reject() sends it back to DRAFT.
  PENDING_APPROVAL
  POSTED
}

// I2 (build plan §5.2, B11): the fixed reason-code list for a WRITE_OFF or
// a negative CORRECTION. Use as-is — not extensible without a new business
// decision.
enum StockAdjustmentReason {
  DAMAGED
  EXPIRED
  LOST
  FOUND
  COUNT_ERROR
  DATA_ENTRY_ERROR
  SAMPLE_OR_INTERNAL_USE
  OTHER
}

// Single warehouse for now (one seeded MAIN row, no management UI); the
// locationId on every stock row keeps multi-warehouse additive later.
model InventoryLocation {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique
  name               String
  isActive           Boolean             @default(true) @map("is_active")
  isDefault          Boolean             @default(false) @map("is_default")
  note               String?
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockAdjustments   StockAdjustment[]
  // I3 (build plan §5.3, B14): per item+location min/reorder/max thresholds.
  itemStockLevels    ItemStockLevel[]
  salesOrders        SalesOrder[]
  deliveries         Delivery[]
  salesReturns       SalesReturn[]
  // I4 (build plan §5.4): per-batch physical buckets at this location.
  stockBatchBalances StockBatchBalance[]
  // I5 (build plan §5.5/§5.11): inbound documents received/produced here.
  goodsReceipts      GoodsReceipt[]
  productionOutputs  ProductionOutput[]
  // I6 (build plan §5.6): stock counts performed at this location.
  stockCounts        StockCount[]
  // I8 (build plan §5.8): goods returns to suppliers, shipped from here.
  goodsReturns       GoodsReturn[]

  @@map("inventory_locations")
}

// I3 (build plan §5.3, B14): user-set per item+location reorder thresholds.
// minQty is compared against *available* stock (onHand − reserved), never
// onHand alone — B14. reorderQty/maxQty are display-only (no automatic
// purchase request is ever created from this table). The system never
// invents a threshold — users set these themselves, nothing is defaulted.
model ItemStockLevel {
  id              Int               @id @default(autoincrement())
  itemId          Int               @map("item_id")
  item            Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId      Int               @map("location_id")
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  minQty          Decimal           @map("min_qty") @db.Decimal(12, 2)
  reorderQty      Decimal?          @map("reorder_qty") @db.Decimal(12, 2)
  maxQty          Decimal?          @map("max_qty") @db.Decimal(12, 2)
  note            String?
  updatedByUserId Int?              @map("updated_by_user_id")
  updatedByUser   User?             @relation("ItemStockLevelUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([itemId, locationId])
  @@map("item_stock_levels")
}

// SQL (hand-added, not modelled by Prisma): CHECK (min_qty >= 0),
// CHECK (max_qty IS NULL OR max_qty >= min_qty) — see migration.sql.

// Running balance per item+location, per bucket. Always equal to the SUM of
// that item+location+bucket's StockMovement rows (InventoryService
// .verifyBalances() checks this).
model StockBalance {
  id         Int               @id @default(autoincrement())
  itemId     Int               @map("item_id")
  item       Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId Int               @map("location_id")
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  onHand     Decimal           @default(0) @map("on_hand") @db.Decimal(12, 2)
  reserved   Decimal           @default(0) @db.Decimal(12, 2)
  qc         Decimal           @default(0) @db.Decimal(12, 2)
  // I8 (build plan §5.8, B9): physically held, not sellable, never folded
  // into "available" — same exclusion treatment as qc/reserved. Only
  // MARK_DAMAGED/RETURN_TO_DAMAGED write it in; only a posted GoodsReturn
  // (SUPPLIER_RETURN) takes it out.
  damaged    Decimal           @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([itemId, locationId])
  @@map("stock_balances")
}

// Append-only. No update/delete code path should ever exist; corrections are new rows.
model StockMovement {
  id              Int                @id @default(autoincrement())
  itemId          Int                @map("item_id")
  item            Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId      Int                @map("location_id")
  location        InventoryLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bucket          StockBucket
  movementType    StockMovementType  @map("movement_type")
  quantity        Decimal            @db.Decimal(12, 2) // signed
  movementDate    DateTime           @map("movement_date")
  referenceType   StockReferenceType @map("reference_type")
  referenceId     Int                @map("reference_id")
  referenceLineId Int?               @map("reference_line_id")
  referenceNumber String?            @map("reference_number")
  note            String?
  createdByUserId Int?               @map("created_by_user_id")
  createdByUser   User?              @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime           @default(now()) @map("created_at")
  // I4 (build plan §5.4): required by applyMovements() on ON_HAND/QC rows of
  // a batch-tracked item; never set on a RESERVED row (hand-added CHECK —
  // batches never apply to the RESERVED bucket, per §5.4a's schema
  // correction). Restrict — a batch with ledger history can't be deleted.
  batchId         Int?               @map("batch_id")
  batch           StockBatch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  // I5 (build plan §5.5, B15): per-unit cost stamped on an inbound movement
  // from a costed document line (goods receipt / production output). Null
  // = unknown/not captured. Outbound average-cost stamping is I9's scope.
  // Hidden behind inventory.cost — the stock-card / movement-browser reads
  // omit it.
  unitCost        Decimal?           @map("unit_cost") @db.Decimal(15, 0)

  @@index([itemId, locationId])
  @@index([referenceType, referenceId])
  @@index([batchId])
  @@map("stock_movements")
}

// Manual stock receipt/adjustment document ("رسید/اصلاح موجودی") — the only
// way stock enters the system (no Purchases/Production integration, rule 7).
// DRAFT is editable/deletable. A kind/net-quantity that needs inventory.approve
// (B10) goes DRAFT → PENDING_APPROVAL (submit, non-editable) → POSTED
// (approve) or back to DRAFT (reject); everything else goes DRAFT → POSTED
// directly (post). POSTED is immutable and carries the gap-free number
// (ADJ-<jalali year>-000001) assigned at posting/approval.
// postedByUserId/postedAt double as "approved by/at" when approval applied —
// approve() and post() write the same two columns (build plan §5.2).
model StockAdjustment {
  id                Int                    @id @default(autoincrement())
  adjustmentNumber  String?                @unique @map("adjustment_number")
  kind              StockAdjustmentKind
  status            StockDocumentStatus    @default(DRAFT)
  locationId        Int                    @map("location_id")
  location          InventoryLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  adjustmentDate    DateTime               @map("adjustment_date")
  reason            String
  // B11: required by the DTO for WRITE_OFF, or CORRECTION with a negative
  // net quantity — nullable here because pre-I2 rows have free text only.
  reasonCode        StockAdjustmentReason? @map("reason_code")
  note              String?
  createdByUserId   Int?                   @map("created_by_user_id")
  createdByUser     User?                  @relation("StockAdjustmentCreatedBy", fields: [createdByUserId], references: [id])
  submittedByUserId Int?                   @map("submitted_by_user_id")
  submittedByUser   User?                  @relation("StockAdjustmentSubmittedBy", fields: [submittedByUserId], references: [id])
  submittedAt       DateTime?              @map("submitted_at")
  postedByUserId    Int?                   @map("posted_by_user_id")
  postedByUser      User?                  @relation("StockAdjustmentPostedBy", fields: [postedByUserId], references: [id])
  postedAt          DateTime?              @map("posted_at")
  rejectedByUserId  Int?                   @map("rejected_by_user_id")
  rejectedByUser    User?                  @relation("StockAdjustmentRejectedBy", fields: [rejectedByUserId], references: [id])
  rejectedAt        DateTime?              @map("rejected_at")
  rejectReason      String?                @map("reject_reason")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at")
  items             StockAdjustmentItem[]

  @@index([status])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                Int             @id @default(autoincrement())
  // Cascade — only draft lines are ever deleted (a posted adjustment has no
  // delete path).
  stockAdjustmentId Int             @map("stock_adjustment_id")
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  itemId            Int             @map("item_id")
  item              Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity          Decimal         @db.Decimal(12, 2) // signed for CORRECTION, positive otherwise
  note              String?
  // I4 (build plan §5.4): batch fields for a batch-tracked item's line —
  // DTO/service enforce exactly one of batchId (pick an existing batch —
  // required for a negative line) / batchNumber (create-or-match, inbound
  // lines only) is set, per the item's tracked state. productionDate/
  // expiryDate feed resolveBatches() when batchNumber creates a new batch.
  batchId           Int?            @map("batch_id")
  batch             StockBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchNumber       String?         @map("batch_number")
  productionDate    DateTime?       @map("production_date")
  expiryDate        DateTime?       @map("expiry_date")

  @@index([stockAdjustmentId])
  @@index([itemId])
  @@map("stock_adjustment_items")
}

// ---------------------------------------------------------------------------
// Inventory batch I4 (2026-10-10): batch/expiry foundation (B7/B8/B21-B24).
// InventoryItemSetting/StockBatch/StockBatchBalance are Inventory-owned
// config/ledger tables (E3) — Item gains no new columns beyond I1's
// itemKind. batchTracked flips only through a posted BATCH_CUTOVER document
// or InventoryItemSettingsService (when the item has zero stock everywhere),
// never a direct edit (E2's lock extends to this flag too).
// ---------------------------------------------------------------------------

model InventoryItemSetting {
  itemId            Int       @id @map("item_id")
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchTracked      Boolean   @default(false) @map("batch_tracked")
  expiryRequired    Boolean   @default(false) @map("expiry_required")
  // Optional: expiry = production date + N days, when a line gives a
  // production date but no printed expiry date (B7).
  shelfLifeDays     Int?      @map("shelf_life_days")
  batchTrackedSince DateTime? @map("batch_tracked_since")
  updatedByUserId   Int?      @map("updated_by_user_id")
  updatedByUser     User?     @relation("InventoryItemSettingUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("inventory_item_settings")
}

// SQL (hand-added): CHECK (shelf_life_days IS NULL OR shelf_life_days > 0).

// A producer's lot, per item. batchNumber is normalized (stock-batches.ts
// normalizeBatchNumber() — digits to Latin, trimmed, whitespace collapsed)
// before the uniqueness check, so the same lot typed with Persian/Arabic
// digits never creates two rows (§5.4a R9).
model StockBatch {
  id                   Int                   @id @default(autoincrement())
  itemId               Int                   @map("item_id")
  item                 Item                  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchNumber          String                @map("batch_number")
  productionDate       DateTime?             @map("production_date")
  expiryDate           DateTime?             @map("expiry_date")
  note                 String?
  createdByUserId      Int?                  @map("created_by_user_id")
  createdByUser        User?                 @relation("StockBatchCreatedBy", fields: [createdByUserId], references: [id])
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at")
  balances             StockBatchBalance[]
  movements            StockMovement[]
  stockAdjustmentItems StockAdjustmentItem[]
  salesReturnItems     SalesReturnItem[]
  // I6 (build plan §5.6): stock-count lines that picked this existing batch.
  stockCountItems      StockCountItem[]
  // I8 (build plan §5.8): goods-return lines that picked this existing batch.
  goodsReturnItems     GoodsReturnItem[]

  @@unique([itemId, batchNumber])
  @@index([itemId, expiryDate])
  @@map("stock_batches")
}

// SQL (hand-added): CHECK (expiry_date IS NULL OR production_date IS NULL OR expiry_date >= production_date).

// Physical buckets (ON_HAND/QC — RESERVED stays item-level only, never
// batch-split) per batch+location. Written ONLY by stock-ledger.ts
// applyMovements(), the same invariant as StockBalance: each batch's
// on_hand/qc must equal the SUM of its own StockMovement rows
// (InventoryService.verifyBalances()'s new BATCH_LEDGER/BATCH_SUM checks).
model StockBatchBalance {
  id         Int               @id @default(autoincrement())
  batchId    Int               @map("batch_id")
  batch      StockBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  itemId     Int               @map("item_id") // denormalized for FEFO queries
  locationId Int               @map("location_id")
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  onHand     Decimal           @default(0) @map("on_hand") @db.Decimal(12, 2)
  qc         Decimal           @default(0) @db.Decimal(12, 2)
  // I8 (build plan §5.8): per-batch mirror of StockBalance.damaged.
  damaged    Decimal           @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([batchId, locationId])
  @@index([itemId, locationId])
  @@map("stock_batch_balances")
}

// SQL (hand-added): CHECK (on_hand >= 0), CHECK (qc >= 0), CHECK (damaged >= 0).

// ---------------------------------------------------------------------------
// Inventory batch I5 (2026-10-11): raw-material/packaging goods receipts
// (B3 reframed, B15, B19) and production output (B1/B2, B15) — build plan
// §5.5/§5.11, used verbatim. Both are DRAFT → POSTED documents (no approval
// step), numbered at posting (GRN-/PRD-<jalali year>-NNNNNN), immutable once
// POSTED (fix with a CORRECTION adjustment). Stock is written only through
// stock-ledger.ts applyMovements() inside the posting transaction.
// ---------------------------------------------------------------------------

// رسید انبار — raw materials / packaging from suppliers. Lines target
// Item.itemKind IN (RAW_MATERIAL, PACKAGING) only (service-enforced).
// purchaseId is deliberately NOT a foreign key (B3, B12 philosophy, CLAUDE.md
// rule 5/7 — Purchases never drive stock); purchaseNumber is a snapshot.
model GoodsReceipt {
  id                     Int                 @id @default(autoincrement())
  receiptNumber          String?             @unique @map("receipt_number") // "GRN", at posting
  locationId             Int                 @map("location_id")
  location               InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receiptDate            DateTime            @map("receipt_date")
  supplierId             Int                 @map("supplier_id")
  supplier               Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName           String              @map("supplier_name") // snapshot
  supplierDocumentNumber String?             @map("supplier_document_number") // supplier's delivery note #
  purchaseId             Int?                @map("purchase_id") // NO FK (B3, B12 philosophy)
  purchaseNumber         String?             @map("purchase_number") // snapshot
  inspectionRequired     Boolean             @default(false) @map("inspection_required") // B19: lines post to QC
  status                 StockDocumentStatus @default(DRAFT)
  note                   String?
  postedByUserId         Int?                @map("posted_by_user_id")
  postedByUser           User?               @relation("GoodsReceiptPostedBy", fields: [postedByUserId], references: [id])
  postedAt               DateTime?           @map("posted_at")
  createdByUserId        Int?                @map("created_by_user_id")
  createdByUser          User?               @relation("GoodsReceiptCreatedBy", fields: [createdByUserId], references: [id])
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at")
  items                  GoodsReceiptItem[]
  // I8 (build plan §5.8): goods returns that cite this receipt (display/cap
  // only — optional).
  goodsReturns           GoodsReturn[]

  @@index([supplierId])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               Int               @id @default(autoincrement())
  goodsReceiptId   Int               @map("goods_receipt_id")
  goodsReceipt     GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade) // drafts only
  lineNo           Int               @map("line_no")
  itemId           Int               @map("item_id")
  item             Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity         Decimal           @db.Decimal(12, 2)
  unitCost         Decimal?          @map("unit_cost") @db.Decimal(15, 0) // B15 — visible/settable only with inventory.cost
  batchNumber      String?           @map("batch_number") // required for batch-tracked items (I4)
  productionDate   DateTime?         @map("production_date")
  expiryDate       DateTime?         @map("expiry_date")
  batchId          Int?              @map("batch_id") // resolved/created at posting
  releasedQty      Decimal           @default(0) @map("released_qty") @db.Decimal(12, 2) // QC → ON_HAND (B19)
  rejectedQty      Decimal           @default(0) @map("rejected_qty") @db.Decimal(12, 2) // left QC via GoodsReturn (I8)
  returnedQty      Decimal           @default(0) @map("returned_qty") @db.Decimal(12, 2) // Σ posted GoodsReturn lines (I8)
  note             String?
  // I8 (build plan §5.8): goods-return lines that picked this receipt line —
  // caps Σ quantity ≤ quantity − returnedQty (service-enforced).
  goodsReturnItems GoodsReturnItem[]

  @@unique([goodsReceiptId, lineNo])
  @@map("goods_receipt_items")
}

// SQL (hand-added): CHECK (quantity > 0), CHECK (unit_cost IS NULL OR
// unit_cost >= 0), CHECK (released_qty >= 0 AND rejected_qty >= 0 AND
// returned_qty >= 0), CHECK (released_qty + rejected_qty <= quantity).

// رسید تولید — the primary finished-goods inbound (the company produces what
// it sells, B1). Lines target Item.itemKind = FINISHED_GOOD only (DTO/service
// enforced). No BOM / raw-material consumption — explicitly out of scope
// (B1, CLAUDE.md rule 9); unitCost is a manually entered per-unit cost (B15).
model ProductionOutput {
  id                   Int                    @id @default(autoincrement())
  outputNumber         String?                @unique @map("output_number") // "PRD", at posting
  locationId           Int                    @map("location_id")
  location             InventoryLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  productionDate       DateTime               @map("production_date")
  producedByEmployeeId Int?                   @map("produced_by_employee_id") // Employee FK, optional — who/which line produced it
  producedByEmployee   Employee?              @relation(fields: [producedByEmployeeId], references: [id], onDelete: SetNull)
  status               StockDocumentStatus    @default(DRAFT)
  note                 String?
  postedByUserId       Int?                   @map("posted_by_user_id")
  postedByUser         User?                  @relation("ProductionOutputPostedBy", fields: [postedByUserId], references: [id])
  postedAt             DateTime?              @map("posted_at")
  createdByUserId      Int?                   @map("created_by_user_id")
  createdByUser        User?                  @relation("ProductionOutputCreatedBy", fields: [createdByUserId], references: [id])
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at")
  items                ProductionOutputItem[]

  @@index([status])
  @@map("production_outputs")
}

model ProductionOutputItem {
  id                 Int              @id @default(autoincrement())
  productionOutputId Int              @map("production_output_id")
  productionOutput   ProductionOutput @relation(fields: [productionOutputId], references: [id], onDelete: Cascade) // drafts only
  lineNo             Int              @map("line_no")
  itemId             Int              @map("item_id") // Restrict; itemKind must be FINISHED_GOOD (service-checked)
  item               Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity           Decimal          @db.Decimal(12, 2)
  unitCost           Decimal?         @map("unit_cost") @db.Decimal(15, 0) // B15: manually entered production cost per unit — no BOM to derive it from
  costIsEstimated    Boolean          @default(false) @map("cost_is_estimated")
  batchNumber        String?          @map("batch_number") // required for batch-tracked finished goods (I4)
  productionDate     DateTime?        @map("production_date") // defaults to header date if omitted
  expiryDate         DateTime?        @map("expiry_date")
  batchId            Int?             @map("batch_id") // resolved/created at posting
  note               String?

  @@unique([productionOutputId, lineNo])
  @@map("production_output_items")
}

// SQL (hand-added): CHECK (quantity > 0), CHECK (unit_cost IS NULL OR unit_cost >= 0).

// ---------------------------------------------------------------------------
// Inventory batch I6 (2026-10-11): stock counts / physical inventory (B13 —
// adopted the architect's default, not yet confirmed by the business owner:
// blind entry, approval by a different person than the submitter, and
// "stale-line" detection instead of freezing warehouse operations during a
// count). Build plan §5.6/§6/§7. Lifecycle: DRAFT (editable/deletable) →
// COUNTING (start(), systemQty snapshotted per line) → REVIEW (submit(),
// every line counted) → POSTED (approve(), variances posted as COUNT_GAIN/
// COUNT_LOSS) or back to COUNTING for selected lines (requestRecount()).
// DRAFT/COUNTING/REVIEW → CANCELLED any time before POSTED. isBlind (default
// true, B13): while true and the count is COUNTING, systemQty is omitted
// from every response to a caller without inventory.approve — enforced by
// StockCountsService, never just hidden in the UI.
// ---------------------------------------------------------------------------

enum StockCountStatus {
  DRAFT
  COUNTING
  REVIEW
  POSTED
  CANCELLED
}

enum StockCountScope {
  FULL // every item with a balance row at the location, populated at start()
  PARTIAL // only the lines the caller specified at create()/update()
}

model StockCount {
  id                Int               @id @default(autoincrement())
  countNumber       String?           @unique @map("count_number") // "CNT", at posting
  locationId        Int               @map("location_id")
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  countDate         DateTime          @map("count_date")
  scope             StockCountScope   @default(PARTIAL)
  isBlind           Boolean           @default(true) @map("is_blind")
  status            StockCountStatus  @default(DRAFT)
  startedAt         DateTime?         @map("started_at") // snapshot moment; also the stale-check anchor, bumped on each requestRecount()
  startedByUserId   Int?              @map("started_by_user_id")
  startedByUser     User?             @relation("StockCountStartedBy", fields: [startedByUserId], references: [id])
  submittedAt       DateTime?         @map("submitted_at")
  submittedByUserId Int?              @map("submitted_by_user_id")
  submittedByUser   User?             @relation("StockCountSubmittedBy", fields: [submittedByUserId], references: [id])
  postedAt          DateTime?         @map("posted_at")
  postedByUserId    Int?              @map("posted_by_user_id")
  postedByUser      User?             @relation("StockCountPostedBy", fields: [postedByUserId], references: [id])
  cancelledAt       DateTime?         @map("cancelled_at")
  cancelledByUserId Int?              @map("cancelled_by_user_id")
  cancelledByUser   User?             @relation("StockCountCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelReason      String?           @map("cancel_reason")
  note              String?
  createdByUserId   Int?              @map("created_by_user_id")
  createdByUser     User?             @relation("StockCountCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")
  items             StockCountItem[]

  @@index([status])
  @@map("stock_counts")
}

model StockCountItem {
  id              Int                    @id @default(autoincrement())
  stockCountId    Int                    @map("stock_count_id")
  stockCount      StockCount             @relation(fields: [stockCountId], references: [id], onDelete: Cascade) // DRAFT/CANCELLED only
  itemId          Int                    @map("item_id")
  item            Item                   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchId         Int?                   @map("batch_id") // I4 present — an existing batch only, never created here
  batch           StockBatch?            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  systemQty       Decimal?               @map("system_qty") @db.Decimal(12, 2) // ON_HAND snapshot at start(); hidden from counters while isBlind + COUNTING
  countedQty      Decimal?               @map("counted_qty") @db.Decimal(12, 2)
  varianceQty     Decimal?               @map("variance_qty") @db.Decimal(12, 2) // counted − system, set at submit()/approve()
  reasonCode      StockAdjustmentReason? @map("reason_code") // required when variance ≠ 0, by approve()
  recountCount    Int                    @default(0) @map("recount_count")
  countedByUserId Int?                   @map("counted_by_user_id")
  countedByUser   User?                  @relation("StockCountItemCountedBy", fields: [countedByUserId], references: [id])
  note            String?

  @@index([stockCountId])
  @@index([itemId])
  @@map("stock_count_items")
}

// SQL (hand-added): CHECK (system_qty IS NULL OR system_qty >= 0),
// CHECK (counted_qty IS NULL OR counted_qty >= 0),
// UNIQUE expression index (stock_count_id, item_id, COALESCE(batch_id, 0)) —
// Prisma's @@unique treats NULLs as distinct, so a plain @@unique([stockCountId,
// itemId, batchId]) would let the same (document, item) appear twice with
// batchId NULL both times; review deliberately, same flag as I4's
// hand-added CHECK constraints.

// ---------------------------------------------------------------------------
// Inventory batch I8 (2026-10-11): damaged bucket + supplier returns (B9 —
// resolved: damaged/expired goods are held and potentially returned to the
// supplier for credit, not thrown away). Build plan §5.8, used verbatim.
// DRAFT → POSTED only (no approval step, like GoodsReceipt), permission
// inventory.receive throughout, number GRT-<jalali year>-NNNNNN at posting.
// ---------------------------------------------------------------------------

// خروج برگشت به تأمین‌کننده — physical stock leaving ON_HAND/QC/DAMAGED back
// to the supplier. purchaseReturnId/purchaseReturnNumber are deliberately NOT
// a foreign key (same loose-coupling convention as PurchaseItem.name,
// CLAUDE.md rule 5) — a stored id+number for display only, pointing at
// Purchases' own financial Return-to-Vendor record; no synchronization
// between the two.
model GoodsReturn {
  id                   Int                 @id @default(autoincrement())
  returnNumber         String?             @unique @map("return_number") // "GRT", at posting
  locationId           Int                 @map("location_id")
  location             InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplierId           Int                 @map("supplier_id")
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName         String              @map("supplier_name") // snapshot
  goodsReceiptId       Int?                @map("goods_receipt_id") // optional — not every return traces to one receipt
  goodsReceipt         GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseReturnId     Int?                @map("purchase_return_id") // NO FK — Purchases' financial RTV record
  purchaseReturnNumber String?             @map("purchase_return_number") // snapshot
  returnDate           DateTime            @map("return_date")
  reason               String
  status               StockDocumentStatus @default(DRAFT)
  note                 String?
  postedByUserId       Int?                @map("posted_by_user_id")
  postedByUser         User?               @relation("GoodsReturnPostedBy", fields: [postedByUserId], references: [id])
  postedAt             DateTime?           @map("posted_at")
  createdByUserId      Int?                @map("created_by_user_id")
  createdByUser        User?               @relation("GoodsReturnCreatedBy", fields: [createdByUserId], references: [id])
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at")
  items                GoodsReturnItem[]

  @@index([supplierId])
  @@index([status])
  @@map("goods_returns")
}

model GoodsReturnItem {
  id                 Int               @id @default(autoincrement())
  goodsReturnId      Int               @map("goods_return_id")
  goodsReturn        GoodsReturn       @relation(fields: [goodsReturnId], references: [id], onDelete: Cascade) // drafts only
  // Caps quantity: Σ returned per receipt line ≤ quantity − returnedQty
  // (overall-any-bucket cap, build plan §6) — optional, a return of general
  // DAMAGED/ON_HAND stock not traceable to one receipt doesn't need this.
  goodsReceiptItemId Int?              @map("goods_receipt_item_id")
  goodsReceiptItem   GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  itemId             Int               @map("item_id")
  item               Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchId            Int?              @map("batch_id") // an existing batch only, never created here
  batch              StockBatch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  fromBucket         StockBucket       @map("from_bucket") // ON_HAND | QC | DAMAGED
  quantity           Decimal           @db.Decimal(12, 2)
  note               String?

  @@index([goodsReturnId])
  @@index([itemId])
  @@map("goods_return_items")
}

// SQL (hand-added): CHECK (quantity > 0), CHECK (from_bucket IN
// ('ON_HAND', 'QC', 'DAMAGED')) — same convention as GoodsReceiptItem's
// hand-added CHECKs.

// ---------------------------------------------------------------------------
// Sales — Sales batch 2 (2026-10-07): sales orders. See
// docs/sales-module-build-plan.md §4.2. Delivery arrived in batch 3;
// SalesInvoice / SalesReturn (and their back-relations) arrive in later batches.
// ---------------------------------------------------------------------------

// OPENING_BALANCE is excluded from sales statistics. Used by SalesInvoice
// (Batch 4); declared with the rest of the Sales enums.
enum SalesSourceType {
  OPERATIONAL
  OPENING_BALANCE
}

// Transitions: backend/src/sales/sales-rules.ts (ALLOWED_SALES_ORDER_STATUS_TRANSITIONS).
enum SalesOrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  COMPLETED
  CLOSED
  CANCELLED
}

// The three progress axes below are derived — never set by hand, never via
// an endpoint. Reused by Delivery / SalesInvoice in later batches.
enum SalesDeliveryStatus {
  NOT_DELIVERED
  PARTIALLY_DELIVERED
  DELIVERED
}

enum SalesInvoicingStatus {
  NOT_INVOICED
  PARTIALLY_INVOICED
  INVOICED
}

// "Overdue" is computed at query time, not stored.
enum SalesPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// سفارش فروش. DRAFT is editable/deletable and carries no number; the
// gap-free number (SO-<jalali year>-000001) and the stock reservation are
// assigned together at CONFIRMED (SalesOrdersService.confirm()/approve()).
// Customer / address / payment-term fields are snapshots: refreshed on every
// DRAFT save, frozen once the order leaves DRAFT.
model SalesOrder {
  id                     Int                  @id @default(autoincrement())
  orderNumber            String?              @unique @map("order_number")
  orderDate              DateTime             @map("order_date")
  customerId             Int                  @map("customer_id")
  customer               Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName           String               @map("customer_name")
  customerEconomicCode   String?              @map("customer_economic_code")
  // Live ref; the text snapshot below is what the order keeps if the address
  // is later edited or removed (hence SetNull, not Restrict).
  deliveryAddressId      Int?                 @map("delivery_address_id")
  deliveryAddress        CustomerAddress?     @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  deliveryAddressText    String?              @map("delivery_address_text")
  paymentTermId          Int?                 @map("payment_term_id")
  paymentTerm            PaymentTerm?         @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  paymentTermName        String?              @map("payment_term_name")
  paymentDueDays         Int                  @default(0) @map("payment_due_days")
  // Employee, never User (CLAUDE.md hard rule 1).
  salespersonEmployeeId  Int?                 @map("salesperson_employee_id")
  salespersonEmployee    Employee?            @relation(fields: [salespersonEmployeeId], references: [id], onDelete: Restrict)
  locationId             Int                  @map("location_id")
  location               InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customerReference      String?              @map("customer_reference")
  requestedDeliveryDate  DateTime?            @map("requested_delivery_date")
  status                 SalesOrderStatus     @default(DRAFT)
  deliveryStatus         SalesDeliveryStatus  @default(NOT_DELIVERED) @map("delivery_status")
  invoicingStatus        SalesInvoicingStatus @default(NOT_INVOICED) @map("invoicing_status")
  paymentStatus          SalesPaymentStatus   @default(UNPAID) @map("payment_status")
  // Derived money fields — written only from sales-totals.ts results.
  subtotal               Decimal              @default(0) @db.Decimal(15, 0)
  discountTotal          Decimal              @default(0) @map("discount_total") @db.Decimal(15, 0)
  taxTotal               Decimal              @default(0) @map("tax_total") @db.Decimal(15, 0)
  totalAmount            Decimal              @default(0) @map("total_amount") @db.Decimal(15, 0)
  approvalReason         String?              @map("approval_reason")
  approvedByUserId       Int?                 @map("approved_by_user_id")
  approvedByUser         User?                @relation("SalesOrderApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt             DateTime?            @map("approved_at")
  creditOverrideByUserId Int?                 @map("credit_override_by_user_id")
  creditOverrideByUser   User?                @relation("SalesOrderCreditOverrideBy", fields: [creditOverrideByUserId], references: [id])
  creditOverrideAt       DateTime?            @map("credit_override_at")
  creditOverrideReason   String?              @map("credit_override_reason")
  confirmedByUserId      Int?                 @map("confirmed_by_user_id")
  confirmedByUser        User?                @relation("SalesOrderConfirmedBy", fields: [confirmedByUserId], references: [id])
  confirmedAt            DateTime?            @map("confirmed_at")
  cancelledByUserId      Int?                 @map("cancelled_by_user_id")
  cancelledByUser        User?                @relation("SalesOrderCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelledAt            DateTime?            @map("cancelled_at")
  cancelReason           String?              @map("cancel_reason")
  closedByUserId         Int?                 @map("closed_by_user_id")
  closedByUser           User?                @relation("SalesOrderClosedBy", fields: [closedByUserId], references: [id])
  closedAt               DateTime?            @map("closed_at")
  closeReason            String?              @map("close_reason")
  internalNote           String?              @map("internal_note")
  // Printed on documents.
  customerNote           String?              @map("customer_note")
  createdByUserId        Int?                 @map("created_by_user_id")
  createdByUser          User?                @relation("SalesOrderCreatedBy", fields: [createdByUserId], references: [id])
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @default(now()) @updatedAt @map("updated_at")
  items                  SalesOrderItem[]
  deliveries             Delivery[]
  invoices               SalesInvoice[]
  returns                SalesReturn[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                  Int                @id @default(autoincrement())
  // Cascade — only DRAFT orders are ever deleted.
  salesOrderId        Int                @map("sales_order_id")
  salesOrder          SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lineNo              Int                @map("line_no")
  itemId              Int                @map("item_id")
  item                Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Snapshots, refreshed on every DRAFT save.
  itemCode            String             @map("item_code")
  itemName            String             @map("item_name")
  unitId              Int                @map("unit_id")
  unit                Unit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  unitName            String             @map("unit_name")
  quantity            Decimal            @db.Decimal(12, 2)
  // Item.sellingPrice at the time of the last DRAFT save.
  listUnitPrice       Decimal?           @map("list_unit_price") @db.Decimal(15, 0)
  unitPrice           Decimal            @map("unit_price") @db.Decimal(15, 0)
  // Required only when unitPrice < listUnitPrice (B2).
  priceOverrideReason String?            @map("price_override_reason")
  // Only settable by a sales.approve holder (B3).
  discountPercent     Decimal?           @map("discount_percent") @db.Decimal(5, 2)
  discountAmount      Decimal            @default(0) @map("discount_amount") @db.Decimal(15, 0)
  // Adjustable, defaults to 0 (B14).
  taxRate             Decimal            @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal            @default(0) @map("tax_amount") @db.Decimal(15, 0)
  lineTotal           Decimal            @map("line_total") @db.Decimal(15, 0)
  // Progress counters — service-layer invariants: delivered ≤ quantity;
  // invoiced ≤ delivered; returned ≤ delivered; reserved ≤ quantity − delivered.
  reservedQty         Decimal            @default(0) @map("reserved_qty") @db.Decimal(12, 2)
  deliveredQty        Decimal            @default(0) @map("delivered_qty") @db.Decimal(12, 2)
  invoicedQty         Decimal            @default(0) @map("invoiced_qty") @db.Decimal(12, 2)
  returnedQty         Decimal            @default(0) @map("returned_qty") @db.Decimal(12, 2)
  note                String?
  deliveryItems       DeliveryItem[]
  invoiceItems        SalesInvoiceItem[]

  @@unique([salesOrderId, lineNo])
  @@index([itemId])
  @@map("sales_order_items")
}

// Delivery, SalesInvoice and CreditNote: DRAFT → POSTED only, one-way;
// POSTED is immutable and terminal (build plan §5).
enum SalesDocumentStatus {
  DRAFT
  POSTED
}

// حواله تحویل — Sales batch 3 (2026-10-07). The ONLY document that lowers
// ON_HAND stock. A DRAFT is editable/deletable and carries no number; the
// gap-free number (DN-<jalali year>-000001), the DELIVERY_ISSUE ledger rows
// and the order's deliveredQty / deliveryStatus are all written together at
// POSTED (DeliveriesService.post()).
model Delivery {
  id                  Int                 @id @default(autoincrement())
  deliveryNumber      String?             @unique @map("delivery_number")
  salesOrderId        Int                 @map("sales_order_id")
  salesOrder          SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  // Denormalized from the order, for queues/filters.
  customerId          Int                 @map("customer_id")
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  locationId          Int                 @map("location_id")
  location            InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  deliveryDate        DateTime            @map("delivery_date")
  status              SalesDocumentStatus @default(DRAFT)
  // Snapshot of the order's delivery address text.
  deliveryAddressText String?             @map("delivery_address_text")
  // Driver / vehicle, free text.
  carrierNote         String?             @map("carrier_note")
  // Customer-side signatory.
  receivedByName      String?             @map("received_by_name")
  note                String?
  postedByUserId      Int?                @map("posted_by_user_id")
  postedByUser        User?               @relation("DeliveryPostedBy", fields: [postedByUserId], references: [id])
  postedAt            DateTime?           @map("posted_at")
  createdByUserId     Int?                @map("created_by_user_id")
  createdByUser       User?               @relation("DeliveryCreatedBy", fields: [createdByUserId], references: [id])
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  items               DeliveryItem[]
  returns             SalesReturn[]

  @@index([salesOrderId])
  @@index([customerId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryItem {
  id               Int                @id @default(autoincrement())
  // Cascade — only DRAFT deliveries are ever deleted.
  deliveryId       Int                @map("delivery_id")
  delivery         Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  salesOrderItemId Int                @map("sales_order_item_id")
  salesOrderItem   SalesOrderItem     @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  itemId           Int                @map("item_id")
  item             Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity         Decimal            @db.Decimal(12, 2)
  // Progress counters for Batches 4 (invoices) and 6 (returns).
  invoicedQty      Decimal            @default(0) @map("invoiced_qty") @db.Decimal(12, 2)
  returnedQty      Decimal            @default(0) @map("returned_qty") @db.Decimal(12, 2)
  invoiceItems     SalesInvoiceItem[]
  returnItems      SalesReturnItem[]

  @@index([deliveryId])
  @@index([salesOrderItemId])
  @@map("delivery_items")
}

// فاکتور فروش — Sales batch 4 (2026-10-07). The AR anchor. A DRAFT carries
// no number and has no effect; at POSTED (SalesInvoicesService.post()) the
// gap-free number (INV-<jalali year>-000001), dueDate, the delivery/order
// lines' invoicedQty and the order's invoicingStatus are written together.
// OPENING_BALANCE invoices (historical AR, no order/delivery) are excluded
// from sales statistics. paidAmount / creditedAmount / paymentStatus are
// written ONLY by SalesInvoicesService.applySettlement() (Receivables).
model SalesInvoice {
  id                         Int                 @id @default(autoincrement())
  invoiceNumber              String?             @unique @map("invoice_number")
  sourceType                 SalesSourceType     @default(OPERATIONAL) @map("source_type")
  customerId                 Int                 @map("customer_id")
  customer                   Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // null only for OPENING_BALANCE.
  salesOrderId               Int?                @map("sales_order_id")
  salesOrder                 SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  invoiceDate                DateTime            @map("invoice_date")
  // Set at posting: invoiceDate + paymentDueDays.
  dueDate                    DateTime?           @map("due_date")
  status                     SalesDocumentStatus @default(DRAFT)
  // Snapshots, taken when the draft is created.
  customerName               String              @map("customer_name")
  customerEconomicCode       String?             @map("customer_economic_code")
  billingAddressText         String?             @map("billing_address_text")
  // Buyer snapshot (2026-10-13), refreshed at DRAFT creation and at post();
  // never backfilled on old invoices. The buyer's national ID is deliberately
  // not snapshotted (decision B14).
  customerKind               CustomerKind?       @map("customer_kind")
  customerLegalName          String?             @map("customer_legal_name")
  customerRegistrationNumber String?             @map("customer_registration_number")
  customerPhone              String?             @map("customer_phone")
  customerProvince           String?             @map("customer_province")
  customerCity               String?             @map("customer_city")
  customerPostalCode         String?             @map("customer_postal_code")
  paymentTermName            String?             @map("payment_term_name")
  paymentDueDays             Int                 @default(0) @map("payment_due_days")
  // Derived money fields — written only from sales-totals.ts results.
  subtotal                   Decimal             @default(0) @db.Decimal(15, 0)
  discountTotal              Decimal             @default(0) @map("discount_total") @db.Decimal(15, 0)
  taxTotal                   Decimal             @default(0) @map("tax_total") @db.Decimal(15, 0)
  totalAmount                Decimal             @default(0) @map("total_amount") @db.Decimal(15, 0)
  // Settlement — written ONLY by SalesInvoicesService.applySettlement().
  paidAmount                 Decimal             @default(0) @map("paid_amount") @db.Decimal(15, 0)
  creditedAmount             Decimal             @default(0) @map("credited_amount") @db.Decimal(15, 0)
  paymentStatus              SalesPaymentStatus  @default(UNPAID) @map("payment_status")
  note                       String?
  postedByUserId             Int?                @map("posted_by_user_id")
  postedByUser               User?               @relation("SalesInvoicePostedBy", fields: [postedByUserId], references: [id])
  postedAt                   DateTime?           @map("posted_at")
  createdByUserId            Int?                @map("created_by_user_id")
  createdByUser              User?               @relation("SalesInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @default(now()) @updatedAt @map("updated_at")
  items                      SalesInvoiceItem[]
  paymentAllocations         PaymentAllocation[]
  creditNotes                CreditNote[]

  @@index([customerId, status])
  @@index([salesOrderId])
  @@index([dueDate])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id               Int              @id @default(autoincrement())
  // Cascade — only DRAFT invoices are ever deleted.
  salesInvoiceId   Int              @map("sales_invoice_id")
  salesInvoice     SalesInvoice     @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  lineNo           Int              @map("line_no")
  // Invoice-what-is-delivered; null only for OPENING_BALANCE.
  deliveryItemId   Int?             @map("delivery_item_id")
  deliveryItem     DeliveryItem?    @relation(fields: [deliveryItemId], references: [id], onDelete: Restrict)
  salesOrderItemId Int?             @map("sales_order_item_id")
  salesOrderItem   SalesOrderItem?  @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  itemId           Int?             @map("item_id")
  item             Item?            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Snapshots ("مانده افتتاحیه" for an opening balance line).
  itemCode         String?          @map("item_code")
  itemName         String           @map("item_name")
  unitName         String?          @map("unit_name")
  quantity         Decimal          @db.Decimal(12, 2)
  unitPrice        Decimal          @map("unit_price") @db.Decimal(15, 0)
  discountAmount   Decimal          @default(0) @map("discount_amount") @db.Decimal(15, 0)
  taxRate          Decimal          @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal          @default(0) @map("tax_amount") @db.Decimal(15, 0)
  lineTotal        Decimal          @map("line_total") @db.Decimal(15, 0)
  // Credit-note progress (Batch 6).
  creditedQty      Decimal          @default(0) @map("credited_qty") @db.Decimal(12, 2)
  creditNoteItems  CreditNoteItem[]

  @@unique([salesInvoiceId, lineNo])
  @@index([deliveryItemId])
  @@index([salesOrderItemId])
  @@map("sales_invoice_items")
}

// ---------------------------------------------------------------------------
// Sales — Sales batch 6 (2026-10-07): returns + credit notes. See
// docs/sales-module-build-plan.md §4.2/§4.3/§5/§6. Returns always reference a
// Delivery (B8 deferred — isUnreferenced stays false/unused). Credit notes
// are return-based only (B15 deferred — no standalone credit notes yet).
// ---------------------------------------------------------------------------

enum ReturnReason {
  DAMAGED
  EXPIRED
  WRONG_ITEM
  QUALITY
  CUSTOMER_REFUSED
  OTHER
}

// Transitions: backend/src/sales/sales-rules.ts (ALLOWED_SALES_RETURN_STATUS_TRANSITIONS).
// REQUESTED → APPROVED|REJECTED|CANCELLED, APPROVED → RECEIVED|CANCELLED,
// RECEIVED → INSPECTED, INSPECTED → COMPLETED (build plan §5).
enum SalesReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  INSPECTED
  COMPLETED
  CANCELLED
}

// مرجوعی فروش (RMA). returnNumber ("RMA-<jalali year>-000001") is assigned at
// APPROVED, not at request — a REQUESTED/REJECTED/CANCELLED-before-approval
// return never gets one (no gap). Stock effects (RETURN_RECEIPT at RECEIVED;
// RETURN_RESTOCK/RETURN_WRITE_OFF at INSPECTED, per line disposition) go
// through inventory/stock-ledger.ts, same as every other Sales document.
model SalesReturn {
  id                Int               @id @default(autoincrement())
  returnNumber      String?           @unique @map("return_number")
  customerId        Int               @map("customer_id")
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Required in practice (B8 is deferred — every return references a
  // delivery today); kept nullable here only so B8's unreferenced returns
  // don't need a migration later.
  salesOrderId      Int?              @map("sales_order_id")
  salesOrder        SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  deliveryId        Int?              @map("delivery_id")
  delivery          Delivery?         @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  locationId        Int               @map("location_id")
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  requestDate       DateTime          @map("request_date")
  reason            ReturnReason
  status            SalesReturnStatus @default(REQUESTED)
  // Unused unless B8 changes.
  isUnreferenced    Boolean           @default(false) @map("is_unreferenced")
  rejectReason      String?           @map("reject_reason")
  note              String?
  requestedByUserId Int?              @map("requested_by_user_id")
  requestedByUser   User?             @relation("SalesReturnRequestedBy", fields: [requestedByUserId], references: [id])
  approvedByUserId  Int?              @map("approved_by_user_id")
  approvedByUser    User?             @relation("SalesReturnApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt        DateTime?         @map("approved_at")
  receivedByUserId  Int?              @map("received_by_user_id")
  receivedByUser    User?             @relation("SalesReturnReceivedBy", fields: [receivedByUserId], references: [id])
  receivedAt        DateTime?         @map("received_at")
  inspectedByUserId Int?              @map("inspected_by_user_id")
  inspectedByUser   User?             @relation("SalesReturnInspectedBy", fields: [inspectedByUserId], references: [id])
  inspectedAt       DateTime?         @map("inspected_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")
  items             SalesReturnItem[]
  creditNotes       CreditNote[]

  @@index([customerId])
  @@index([salesOrderId])
  @@index([deliveryId])
  @@index([status])
  @@map("sales_returns")
}

model SalesReturnItem {
  id              Int              @id @default(autoincrement())
  // Cascade — a return's lines only ever exist alongside it.
  salesReturnId   Int              @map("sales_return_id")
  salesReturn     SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  // Caps requested/received quantity: Σ returned per delivery line ≤
  // delivered − already returned (deliveryItem.returnedQty).
  deliveryItemId  Int?             @map("delivery_item_id")
  deliveryItem    DeliveryItem?    @relation(fields: [deliveryItemId], references: [id], onDelete: Restrict)
  itemId          Int              @map("item_id")
  item            Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemName        String           @map("item_name")
  unitName        String           @map("unit_name")
  // I4 (build plan §5.4/B22/B24): which batch this line's stock physically
  // went back into (QC, at receive time) — resolved from the delivery's own
  // issued batch(es), or typed as a lot number if the delivery predates the
  // item's cutover (B22). One batch per line only (B24) — a FEFO-split
  // delivery returned across two batches is two return documents.
  batchId         Int?             @map("batch_id")
  batch           StockBatch?      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  // Price actually charged, snapshotted from the invoice/order line.
  unitPrice       Decimal          @map("unit_price") @db.Decimal(15, 0)
  requestedQty    Decimal          @map("requested_qty") @db.Decimal(12, 2)
  receivedQty     Decimal          @default(0) @map("received_qty") @db.Decimal(12, 2)
  restockQty      Decimal          @default(0) @map("restock_qty") @db.Decimal(12, 2)
  // I8 (build plan §5.8, B9): "to damaged" disposition — physically held,
  // not sellable (posts RETURN_TO_DAMAGED: QC out, DAMAGED in).
  // restockQty + writeOffQty + damagedQty = receivedQty (service-layer invariant).
  writeOffQty     Decimal          @default(0) @map("write_off_qty") @db.Decimal(12, 2)
  damagedQty      Decimal          @default(0) @map("damaged_qty") @db.Decimal(12, 2)
  creditedQty     Decimal          @default(0) @map("credited_qty") @db.Decimal(12, 2)
  conditionNote   String?          @map("condition_note")
  creditNoteItems CreditNoteItem[]

  @@index([salesReturnId])
  @@index([deliveryItemId])
  @@map("sales_return_items")
}

// یادداشت اعتباری — only ever created from an INSPECTED SalesReturn (B15:
// no standalone/goodwill credit notes this batch). DRAFT → POSTED, one-way,
// like Delivery/SalesInvoice (reuses SalesDocumentStatus). creditNoteNumber
// ("CN-<jalali year>-000001") is assigned at posting. Posting calls
// SalesInvoicesService.applySettlement() (reduces AR via creditedAmount —
// never writes it directly) and then the return's markCredited().
model CreditNote {
  id                 Int                 @id @default(autoincrement())
  creditNoteNumber   String?             @unique @map("credit_note_number")
  customerId         Int                 @map("customer_id")
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoiceId     Int                 @map("sales_invoice_id")
  salesInvoice       SalesInvoice        @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  // Null only if B15 ever changes — always set today (return-based only).
  salesReturnId      Int?                @map("sales_return_id")
  salesReturn        SalesReturn?        @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  creditDate         DateTime            @map("credit_date")
  reason             String
  status             SalesDocumentStatus @default(DRAFT)
  subtotal           Decimal             @default(0) @db.Decimal(15, 0)
  taxTotal           Decimal             @default(0) @map("tax_total") @db.Decimal(15, 0)
  totalAmount        Decimal             @default(0) @map("total_amount") @db.Decimal(15, 0)
  postedByUserId     Int?                @map("posted_by_user_id")
  postedByUser       User?               @relation("CreditNotePostedBy", fields: [postedByUserId], references: [id])
  postedAt           DateTime?           @map("posted_at")
  createdByUserId    Int?                @map("created_by_user_id")
  createdByUser      User?               @relation("CreditNoteCreatedBy", fields: [createdByUserId], references: [id])
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")
  items              CreditNoteItem[]
  paymentAllocations PaymentAllocation[] @relation("PaymentAllocationSourceCreditNote")

  @@index([customerId])
  @@index([salesInvoiceId])
  @@index([salesReturnId])
  @@index([status])
  @@map("credit_notes")
}

model CreditNoteItem {
  id                 Int              @id @default(autoincrement())
  // Cascade — a credit note's lines only ever exist alongside it; a DRAFT
  // credit note has no other delete path either (it has no number yet).
  creditNoteId       Int              @map("credit_note_id")
  creditNote         CreditNote       @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  // Restrict — an invoice line credited against can't be deleted (invoice
  // lines never are, posted or not, but this matches the project's
  // convention for referenced lines).
  salesInvoiceItemId Int              @map("sales_invoice_item_id")
  salesInvoiceItem   SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Restrict)
  salesReturnItemId  Int?             @map("sales_return_item_id")
  salesReturnItem    SalesReturnItem? @relation(fields: [salesReturnItemId], references: [id], onDelete: Restrict)
  // Null = an amount-only correction (not produced by this batch's
  // return-based flow, but kept per build plan §4.3's schema).
  quantity           Decimal?         @db.Decimal(12, 2)
  unitPrice          Decimal?         @map("unit_price") @db.Decimal(15, 0)
  taxAmount          Decimal          @default(0) @map("tax_amount") @db.Decimal(15, 0)
  lineTotal          Decimal          @map("line_total") @db.Decimal(15, 0)

  @@index([creditNoteId])
  @@map("credit_note_items")
}

// ---------------------------------------------------------------------------
// Receivables — Sales batch 5 (2026-10-07), extended in batch 6 (2026-10-07):
// CreditNote/CreditNoteItem are defined above (with the Sales models they
// reference), and PaymentAllocation.sourceCreditNoteId/targetRefundId now
// carry real FKs (to CreditNote and CustomerPayment respectively).
// ---------------------------------------------------------------------------

enum CustomerPaymentDirection {
  RECEIPT
  REFUND
}

// دریافت/پرداخت نقدی مشتری. direction=RECEIPT lowers AR (once COMPLETED);
// REFUND raises it back. status reuses the shared PaymentStatus enum
// (Purchases): COMPLETED immediately for cash/bank/card, PENDING for an
// uncleared cheque (B9) until CustomerPaymentsService.clearCheque() moves it
// to COMPLETED (bounceCheque() moves it to CANCELLED instead, reversing its
// allocations). A COMPLETED payment may also be CANCELLED directly (reason
// required), which also reverses its allocations — never deleted.
model CustomerPayment {
  id                        Int                       @id @default(autoincrement())
  // Numbered on save (RCP-<jalali year>-000001) — no draft stage, unlike
  // Sales documents.
  paymentNumber             String                    @unique @map("payment_number")
  direction                 CustomerPaymentDirection  @default(RECEIPT)
  customerId                Int                       @map("customer_id")
  customer                  Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentDate               DateTime                  @map("payment_date")
  amount                    Decimal                   @db.Decimal(15, 0)
  method                    PaymentMethod
  status                    PaymentStatus             @default(COMPLETED)
  referenceNumber           String?                   @map("reference_number")
  // B9: required when status is PENDING at creation (an uncleared cheque).
  chequeDueDate             DateTime?                 @map("cheque_due_date")
  bankName                  String?                   @map("bank_name")
  note                      String?
  cancelledByUserId         Int?                      @map("cancelled_by_user_id")
  cancelledByUser           User?                     @relation("CustomerPaymentCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelledAt               DateTime?                 @map("cancelled_at")
  cancelReason              String?                   @map("cancel_reason")
  // Transfer-receipt info (2026-10-13) — informational only. transactionTime
  // is "HH:MM" Tehran wall clock on paymentDate; the tracking code (کد پیگیری)
  // reuses referenceNumber.
  transactionTime           String?                   @map("transaction_time")
  transactionType           String?                   @map("transaction_type")
  depositId                 String?                   @map("deposit_id")
  withdrawalId              String?                   @map("withdrawal_id")
  sourceAccount             String?                   @map("source_account")
  destinationAccount        String?                   @map("destination_account")
  destinationAccountHolder  String?                   @map("destination_account_holder")
  createdByUserId           Int?                      @map("created_by_user_id")
  createdByUser             User?                     @relation("CustomerPaymentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @default(now()) @updatedAt @map("updated_at")
  allocationsAsSource       PaymentAllocation[]       @relation("PaymentAllocationSourcePayment")
  allocationsAsRefundTarget PaymentAllocation[]       @relation("PaymentAllocationTargetRefund")
  documents                 CustomerPaymentDocument[]

  @@index([customerId])
  @@index([status])
  @@map("customer_payments")
}

// Supporting files for a customer payment (transfer slip, cheque photo, …) —
// 2026-10-14. One row per uploaded file (single-step upload, unlike
// PurchaseDocument's metadata-then-file two steps). Files live under
// uploads/customer-payments and are served only through the guarded
// CustomerPaymentFilesController. Purely informational — never feeds any
// total/status.
model CustomerPaymentDocument {
  id                Int             @id @default(autoincrement())
  customerPaymentId Int             @map("customer_payment_id")
  customerPayment   CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  originalName      String          @map("original_name")
  filePath          String          @map("file_path")
  note              String?
  uploadedByUserId  Int?            @map("uploaded_by_user_id")
  uploadedByUser    User?           @relation("CustomerPaymentDocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt        DateTime        @default(now()) @map("uploaded_at")

  @@index([customerPaymentId])
  @@map("customer_payment_documents")
}

// Open-item AR ledger: one credit source (a RECEIPT CustomerPayment, or —
// since Batch 6 — a CreditNote) settles one debit target (a SalesInvoice, or
// — since Batch 6 — a REFUND CustomerPayment; see the hand-added CHECK in
// the migration). sourceCreditNoteId → CreditNote.id and targetRefundId →
// CustomerPayment.id are real FKs as of Batch 6 (both Restrict — an
// allocation keeps its source/target from being deleted out from under it).
// Reversal is a stamp (reversedAt/reversedByUserId), never a delete —
// recomputeInvoiceSettlement() sums only non-reversed rows.
model PaymentAllocation {
  id                 Int              @id @default(autoincrement())
  customerId         Int              @map("customer_id")
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // A RECEIPT CustomerPayment.
  sourcePaymentId    Int?             @map("source_payment_id")
  sourcePayment      CustomerPayment? @relation("PaymentAllocationSourcePayment", fields: [sourcePaymentId], references: [id], onDelete: Restrict)
  // A posted CreditNote.
  sourceCreditNoteId Int?             @map("source_credit_note_id")
  sourceCreditNote   CreditNote?      @relation("PaymentAllocationSourceCreditNote", fields: [sourceCreditNoteId], references: [id], onDelete: Restrict)
  targetInvoiceId    Int?             @map("target_invoice_id")
  targetInvoice      SalesInvoice?    @relation(fields: [targetInvoiceId], references: [id], onDelete: Restrict)
  // A REFUND CustomerPayment.
  targetRefundId     Int?             @map("target_refund_id")
  targetRefund       CustomerPayment? @relation("PaymentAllocationTargetRefund", fields: [targetRefundId], references: [id], onDelete: Restrict)
  amount             Decimal          @db.Decimal(15, 0)
  allocatedAt        DateTime         @default(now()) @map("allocated_at")
  allocatedByUserId  Int?             @map("allocated_by_user_id")
  allocatedByUser    User?            @relation("PaymentAllocationAllocatedBy", fields: [allocatedByUserId], references: [id])
  reversedAt         DateTime?        @map("reversed_at")
  reversedByUserId   Int?             @map("reversed_by_user_id")
  reversedByUser     User?            @relation("PaymentAllocationReversedBy", fields: [reversedByUserId], references: [id])

  @@index([customerId])
  @@index([targetInvoiceId])
  @@index([sourcePaymentId])
  @@index([sourceCreditNoteId])
  @@index([targetRefundId])
  @@map("payment_allocations")
}

model Role {
  id                        Int                        @id @default(autoincrement())
  name                      String                     @unique
  users                     User[]
  permissions               RolePermission[]
  // Workflow engine: approval steps that name this role as the approver.
  workflowRuleSteps         WorkflowRuleStep[]
  approvalSteps             ApprovalStep[]
  workflowRuleStepApprovers WorkflowRuleStepApprover[] @relation("WorkflowRuleStepApproverRole")
  approvalStepApprovers     ApprovalStepApprover[]     @relation("ApprovalStepApproverRole")

  @@map("roles")
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  String           @unique
  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// USER is an independent system-login account. It is NOT linked to EMPLOYEE.
// A person's Employee record (Master Data) and their User account (if any)
// are separate, unrelated entities — see database_plan.txt at the project root.
model User {
  id                           Int                        @id @default(autoincrement())
  username                     String                     @unique
  passwordHash                 String                     @map("password_hash")
  email                        String?
  phone                        String?
  // Display name for pickers and letters (the login is only a username).
  // Plain account data — NOT an Employee link (CLAUDE.md rule 1).
  fullName                     String?                    @map("full_name")
  roleId                       Int                        @map("role_id")
  role                         Role                       @relation(fields: [roleId], references: [id])
  status                       UserStatus                 @default(ACTIVE)
  createdAt                    DateTime                   @default(now()) @map("created_at")
  lastLoginAt                  DateTime?                  @map("last_login_at")
  auditLogs                    AuditLog[]
  deletedRecords               DeletedRecord[] @relation("DeletedRecordDeletedBy")
  restoredRecords              DeletedRecord[] @relation("DeletedRecordRestoredBy")
  permissions                  UserPermission[]
  // Purchase Requests this account entered (PurchaseRequest.createdByUser) — data-entry
  // provenance, distinct from requestedByEmployee (who actually asked for it).
  createdPurchaseRequests      PurchaseRequest[]
  // Returns-to-vendor this account entered (PurchaseReturn.createdByUser) —
  // same data-entry provenance meaning as createdPurchaseRequests above.
  createdPurchaseReturns       PurchaseReturn[]
  // Customer-module data-entry provenance — same meaning as above.
  createdCustomers             Customer[]
  customerNotes                CustomerNote[]
  uploadedCustomerDocuments    CustomerDocument[]
  ownedCustomerComplaints      CustomerComplaint[]        @relation("CustomerComplaintOwner")
  createdCustomerComplaints    CustomerComplaint[]        @relation("CustomerComplaintCreatedBy")
  // Inventory data-entry provenance — same meaning as above. Each *ByUserId
  // field has its own named relation.
  createdStockMovements        StockMovement[]            @relation("StockMovementCreatedBy")
  createdStockAdjustments      StockAdjustment[]          @relation("StockAdjustmentCreatedBy")
  postedStockAdjustments       StockAdjustment[]          @relation("StockAdjustmentPostedBy")
  // I2: submit/reject provenance — approve() reuses postedStockAdjustments above.
  submittedStockAdjustments    StockAdjustment[]          @relation("StockAdjustmentSubmittedBy")
  rejectedStockAdjustments     StockAdjustment[]          @relation("StockAdjustmentRejectedBy")
  // I3: who last edited an item's min/reorder/max thresholds.
  updatedItemStockLevels       ItemStockLevel[]           @relation("ItemStockLevelUpdatedBy")
  // I4: batch/expiry provenance — same data-entry-provenance meaning as above.
  updatedInventoryItemSettings InventoryItemSetting[]     @relation("InventoryItemSettingUpdatedBy")
  createdStockBatches          StockBatch[]               @relation("StockBatchCreatedBy")
  // I5: goods-receipt / production-output provenance.
  createdGoodsReceipts         GoodsReceipt[]             @relation("GoodsReceiptCreatedBy")
  postedGoodsReceipts          GoodsReceipt[]             @relation("GoodsReceiptPostedBy")
  createdProductionOutputs     ProductionOutput[]         @relation("ProductionOutputCreatedBy")
  postedProductionOutputs      ProductionOutput[]         @relation("ProductionOutputPostedBy")
  // I6: stock-count provenance — one named relation per *ByUserId field.
  createdStockCounts           StockCount[]               @relation("StockCountCreatedBy")
  startedStockCounts           StockCount[]               @relation("StockCountStartedBy")
  submittedStockCounts         StockCount[]               @relation("StockCountSubmittedBy")
  postedStockCounts            StockCount[]               @relation("StockCountPostedBy")
  cancelledStockCounts         StockCount[]               @relation("StockCountCancelledBy")
  countedStockCountItems       StockCountItem[]           @relation("StockCountItemCountedBy")
  // I8: goods-return provenance.
  createdGoodsReturns          GoodsReturn[]              @relation("GoodsReturnCreatedBy")
  postedGoodsReturns           GoodsReturn[]              @relation("GoodsReturnPostedBy")
  // Sales-order provenance (Sales batch 2) — one named relation per field.
  createdSalesOrders           SalesOrder[]               @relation("SalesOrderCreatedBy")
  approvedSalesOrders          SalesOrder[]               @relation("SalesOrderApprovedBy")
  creditOverriddenSalesOrders  SalesOrder[]               @relation("SalesOrderCreditOverrideBy")
  confirmedSalesOrders         SalesOrder[]               @relation("SalesOrderConfirmedBy")
  cancelledSalesOrders         SalesOrder[]               @relation("SalesOrderCancelledBy")
  closedSalesOrders            SalesOrder[]               @relation("SalesOrderClosedBy")
  // Delivery provenance (Sales batch 3).
  createdDeliveries            Delivery[]                 @relation("DeliveryCreatedBy")
  postedDeliveries             Delivery[]                 @relation("DeliveryPostedBy")
  // Sales-invoice provenance (Sales batch 4).
  createdSalesInvoices         SalesInvoice[]             @relation("SalesInvoiceCreatedBy")
  postedSalesInvoices          SalesInvoice[]             @relation("SalesInvoicePostedBy")
  // Receivables provenance (Sales batch 5).
  cancelledCustomerPayments    CustomerPayment[]          @relation("CustomerPaymentCancelledBy")
  createdCustomerPayments      CustomerPayment[]          @relation("CustomerPaymentCreatedBy")
  allocatedPaymentAllocations  PaymentAllocation[]        @relation("PaymentAllocationAllocatedBy")
  reversedPaymentAllocations   PaymentAllocation[]        @relation("PaymentAllocationReversedBy")
  // Sales-return provenance (Sales batch 6) — one named relation per field.
  requestedSalesReturns        SalesReturn[]              @relation("SalesReturnRequestedBy")
  customerPaymentDocuments     CustomerPaymentDocument[]  @relation("CustomerPaymentDocumentUploadedBy")
  approvedSalesReturns         SalesReturn[]              @relation("SalesReturnApprovedBy")
  receivedSalesReturns         SalesReturn[]              @relation("SalesReturnReceivedBy")
  inspectedSalesReturns        SalesReturn[]              @relation("SalesReturnInspectedBy")
  // Credit-note provenance (Sales batch 6).
  createdCreditNotes           CreditNote[]               @relation("CreditNoteCreatedBy")
  postedCreditNotes            CreditNote[]               @relation("CreditNotePostedBy")
  // Letters (نامه‌نگاری): written, received, and attached by this account.
  sentLetters                  Letter[]                   @relation("LetterSender")
  // Workflow engine (موتور گردش کار): provenance + named approvers.
  createdWorkflowRules         WorkflowRule[]             @relation("WorkflowRuleCreatedBy")
  updatedWorkflowRules         WorkflowRule[]             @relation("WorkflowRuleUpdatedBy")
  workflowRuleSteps            WorkflowRuleStep[]
  requestedApprovals           ApprovalRequest[]          @relation("ApprovalRequestedBy")
  approvalSteps                ApprovalStep[]             @relation("ApprovalStepApprover")
  decidedApprovalSteps         ApprovalStep[]             @relation("ApprovalStepDecidedBy")
  workflowRuleStepApprovers    WorkflowRuleStepApprover[] @relation("WorkflowRuleStepApproverUser")
  approvalStepApprovers        ApprovalStepApprover[]     @relation("ApprovalStepApproverUser")
  receivedLetters              LetterRecipient[]          @relation("LetterRecipientUser")
  uploadedLetterAttachments    LetterAttachment[]         @relation("LetterAttachmentUploadedBy")

  @@map("users")
}

model UserPermission {
  userId       Int        @map("user_id")
  permissionId Int        @map("permission_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")
  details    String?
  ipAddress  String?  @map("ip_address")
  // Optional field-level diff: [{ field, from, to }]. Sensitive fields
  // (e.g. Customer.nationalId) are recorded as "changed" with masked values,
  // never the real value. See AuditService.log().
  changes    Json?

  @@map("audit_logs")
}

// Which purchase types a supplier is used for (many-to-many).
model SupplierPurchaseType {
  supplierId     Int          @map("supplier_id")
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseTypeId Int          @map("purchase_type_id")
  purchaseType   PurchaseType @relation(fields: [purchaseTypeId], references: [id], onDelete: Restrict)

  @@id([supplierId, purchaseTypeId])
  @@index([purchaseTypeId])
  @@map("supplier_purchase_types")
}

// A good/material we get from a supplier — plain text on purpose (purchases are
// not limited to Items; same rule as PurchaseItem.name).
model SupplierGood {
  id         Int      @id @default(autoincrement())
  supplierId Int      @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  note       String?
  sortOrder  Int      @default(1) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([supplierId])
  @@map("supplier_goods")
}

// Snapshot of a business record at the moment it was deleted (so "a purchase
// was deleted" in the activity feed can be answered later). View-only — a
// delete is not undone from here. Rows are purged after `expiresAt`
// (DMS_DELETED_RECORD_RETENTION_DAYS, default 90). Sensitive values (national
// IDs) are redacted before writing. No FK to the deleted entity (it is gone).
model DeletedRecord {
  id              Int      @id @default(autoincrement())
  entityType      String   @map("entity_type")
  entityId        Int      @map("entity_id")
  label           String?
  snapshot        Json
  deletedByUserId Int?     @map("deleted_by_user_id")
  deletedBy       User?    @relation("DeletedRecordDeletedBy", fields: [deletedByUserId], references: [id])
  deletedAt       DateTime @default(now()) @map("deleted_at")
  expiresAt       DateTime @map("expires_at")
  // Set when an admin restores the record from this snapshot (the row is kept
  // as history; a restored snapshot can't be restored twice).
  restoredAt       DateTime? @map("restored_at")
  restoredByUserId Int?      @map("restored_by_user_id")
  restoredBy       User?     @relation("DeletedRecordRestoredBy", fields: [restoredByUserId], references: [id])

  @@index([expiresAt])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("deleted_records")
}

// Internal correspondence between system users (نامه‌نگاری, v1: users only —
// no departments, no outside parties). A letter is a DRAFT visible only to its
// sender until it is sent; sending claims the gap-free LTR-<jalali year>-NNNNNN
// number and creates one LetterRecipient row per addressee (that row IS the
// delivery and the only source of read access for recipients). A SENT letter is
// never edited or deleted.
enum LetterStatus {
  DRAFT
  SENT
}

model Letter {
  id           Int          @id @default(autoincrement())
  // Null while DRAFT; assigned at send time.
  letterNumber String?      @unique @map("letter_number")
  status       LetterStatus @default(DRAFT)
  subject      String
  body         String
  senderUserId Int          @map("sender_user_id")
  senderUser   User         @relation("LetterSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  inReplyToId  Int?         @map("in_reply_to_id")
  inReplyTo    Letter?      @relation("LetterReply", fields: [inReplyToId], references: [id], onDelete: Restrict)
  replies      Letter[]     @relation("LetterReply")
  sentAt       DateTime?    @map("sent_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  recipients  LetterRecipient[]
  attachments LetterAttachment[]

  @@index([senderUserId, status, sentAt])
  @@index([inReplyToId])
  @@map("letters")
}

// One row per addressee, created when the letter is sent. readAt/archivedAt
// are the recipient's own state — nobody else's.
model LetterRecipient {
  letterId   Int       @map("letter_id")
  letter     Letter    @relation(fields: [letterId], references: [id], onDelete: Cascade)
  userId     Int       @map("user_id")
  user       User      @relation("LetterRecipientUser", fields: [userId], references: [id], onDelete: Restrict)
  readAt     DateTime? @map("read_at")
  archivedAt DateTime? @map("archived_at")

  @@id([letterId, userId])
  @@index([userId, archivedAt, readAt])
  @@map("letter_recipients")
}

model LetterAttachment {
  id               Int      @id @default(autoincrement())
  letterId         Int      @map("letter_id")
  letter           Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  // /uploads/letters/<uuid>.<ext> — never served statically; downloads go
  // through the guarded letters controller, which checks the parent letter's
  // visibility.
  filePath         String   @map("file_path")
  originalName     String   @map("original_name")
  sizeBytes        Int      @map("size_bytes")
  uploadedByUserId Int?     @map("uploaded_by_user_id")
  uploadedByUser   User?    @relation("LetterAttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([letterId])
  @@map("letter_attachments")
}

/// Managed entirely by connect-pg-simple (the express-session Postgres
/// store) at runtime — never created or altered by a Prisma migration.
/// Declared here, with @@ignore, only so Prisma recognizes the table and
/// stops reporting it as drift; no Prisma Client methods are generated
/// for it. The "baseline_user_sessions" migration records that it
/// already exists rather than trying to (re)create it.
model user_sessions {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@ignore
}

// ─── Workflow engine (موتور گردش کار و تأیید) ───────────────────────────────
// Rules decide WHICH documents need approval and by whom; ApprovalRequest /
// ApprovalStep are the per-document instances. The owning module (Purchases,
// Sales, Purchase Requests) passes facts in and changes its own status — the
// engine never writes another module's tables, and ApprovalRequest has NO FK
// to the document (documentType + documentId, polymorphic). Scope ids on a
// rule (purchase type / supplier / department) are plain ints validated by
// the service, not FKs: they are other modules' master data (CLAUDE.md rule 11).
enum WorkflowDocumentType {
  PURCHASE
  SALES_ORDER
  PURCHASE_REQUEST
}

enum WorkflowAmountBasis {
  TOTAL
  ANY_LINE_TOTAL
  ANY_UNIT_PRICE
}

enum WorkflowApproverType {
  ROLE
  USER
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum ApprovalStepStatus {
  WAITING
  OPEN
  APPROVED
  REJECTED
  CANCELLED
}

model WorkflowRule {
  id                    Int                  @id @default(autoincrement())
  name                  String
  documentType          WorkflowDocumentType @map("document_type")
  isActive              Boolean              @default(true) @map("is_active")
  // First active match by sortOrder wins; higher amount bands go first.
  sortOrder             Int                  @map("sort_order")
  version               Int                  @default(1)
  // Scope — null means "any".
  purchaseTypeId        Int?                 @map("purchase_type_id")
  supplierId            Int?                 @map("supplier_id")
  requesterDepartmentId Int?                 @map("requester_department_id")
  amountBasis           WorkflowAmountBasis  @default(TOTAL) @map("amount_basis")
  // minAmount inclusive, maxAmount exclusive; both null = any amount.
  minAmount             Decimal?             @map("min_amount") @db.Decimal(15, 0)
  maxAmount             Decimal?             @map("max_amount") @db.Decimal(15, 0)
  // Sales orders: the rule only applies to an order that carries a discount
  // whose largest line discount is at least this many percent (0 = any
  // discount). null = no discount condition.
  minDiscountPercent    Decimal?             @map("min_discount_percent") @db.Decimal(5, 2)
  notifyByLetter        Boolean              @default(true) @map("notify_by_letter")
  note                  String?
  createdByUserId       Int?                 @map("created_by_user_id")
  createdByUser         User?                @relation("WorkflowRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId       Int?                 @map("updated_by_user_id")
  updatedByUser         User?                @relation("WorkflowRuleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  steps                 WorkflowRuleStep[]
  requests              ApprovalRequest[]

  @@index([documentType, isActive, sortOrder])
  @@map("workflow_rules")
}

// One approver spec per level (levels run in order). Migration adds a CHECK:
// ROLE => role_id set / user_id null; USER => the reverse.
model WorkflowRuleStep {
  id           Int                        @id @default(autoincrement())
  ruleId       Int                        @map("rule_id")
  rule         WorkflowRule               @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  level        Int
  approverType WorkflowApproverType?      @map("approver_type")
  roleId       Int?                       @map("role_id")
  role         Role?                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  userId       Int?                       @map("user_id")
  user         User?                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  label        String?
  // Approvers of the step: ANY ONE of them may decide it (first to act wins).
  // The three columns above are legacy (single approver) — no longer read or
  // written; the rows were copied into `approvers` by the 2026-10-14 migration.
  approvers    WorkflowRuleStepApprover[]

  @@unique([ruleId, level])
  @@map("workflow_rule_steps")
}

model WorkflowRuleStepApprover {
  id           Int                  @id @default(autoincrement())
  stepId       Int                  @map("step_id")
  step         WorkflowRuleStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  approverType WorkflowApproverType @map("approver_type")
  roleId       Int?                 @map("role_id")
  role         Role?                @relation("WorkflowRuleStepApproverRole", fields: [roleId], references: [id], onDelete: Restrict)
  userId       Int?                 @map("user_id")
  user         User?                @relation("WorkflowRuleStepApproverUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([stepId])
  @@map("workflow_rule_step_approvers")
}

// A document's approval instance. Everything needed to explain the decision
// later is snapshotted here, so later edits of the rule never change it.
// Migration adds a partial unique index: one PENDING request per document.
model ApprovalRequest {
  id                Int                   @id @default(autoincrement())
  documentType      WorkflowDocumentType  @map("document_type")
  documentId        Int                   @map("document_id")
  documentNumber    String                @map("document_number")
  summary           String
  amount            Decimal               @db.Decimal(15, 0)
  status            ApprovalRequestStatus @default(PENDING)
  ruleId            Int?                  @map("rule_id")
  rule              WorkflowRule?         @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleVersion       Int                   @map("rule_version")
  ruleNameSnapshot  String                @map("rule_name_snapshot")
  notifyByLetter    Boolean               @default(true) @map("notify_by_letter")
  factsSnapshot     Json                  @map("facts_snapshot")
  currentLevel      Int                   @map("current_level")
  requestedByUserId Int                   @map("requested_by_user_id")
  requestedByUser   User                  @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime              @default(now()) @map("created_at")
  decidedAt         DateTime?             @map("decided_at")
  closeReason       String?               @map("close_reason")
  steps             ApprovalStep[]

  @@index([documentType, documentId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalStep {
  id                   Int                    @id @default(autoincrement())
  requestId            Int                    @map("request_id")
  request              ApprovalRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  level                Int
  approverType         WorkflowApproverType?  @map("approver_type")
  roleId               Int?                   @map("role_id")
  role                 Role?                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  userId               Int?                   @map("user_id")
  user                 User?                  @relation("ApprovalStepApprover", fields: [userId], references: [id], onDelete: Restrict)
  approverLabel        String                 @map("approver_label")
  // Snapshot of who may decide this step (any one of them). roleId/userId/
  // approverType above are legacy single-approver columns, no longer used.
  approvers            ApprovalStepApprover[]
  status               ApprovalStepStatus     @default(WAITING)
  decidedByUserId      Int?                   @map("decided_by_user_id")
  decidedByUser        User?                  @relation("ApprovalStepDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt            DateTime?              @map("decided_at")
  comment              String?
  // Plain id, no FK — the letters tables belong to the Letters module.
  notificationLetterId Int?                   @map("notification_letter_id")

  @@unique([requestId, level])
  @@map("approval_steps")
}

model ApprovalStepApprover {
  id           Int                  @id @default(autoincrement())
  stepId       Int                  @map("step_id")
  step         ApprovalStep         @relation(fields: [stepId], references: [id], onDelete: Cascade)
  approverType WorkflowApproverType @map("approver_type")
  roleId       Int?                 @map("role_id")
  role         Role?                @relation("ApprovalStepApproverRole", fields: [roleId], references: [id], onDelete: Restrict)
  userId       Int?                 @map("user_id")
  user         User?                @relation("ApprovalStepApproverUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([stepId])
  @@index([roleId])
  @@index([userId])
  @@map("approval_step_approvers")
}

// Backup / restore (migration 20261015210000_backup_and_change_log). These tables are written by
// the backup module and the capture triggers; they are never part of a backup themselves.
model BackupState {
  id                   Int       @id @default(1)
  databaseId           String    @default(dbgenerated("gen_random_uuid()")) @map("database_id") @db.Uuid
  generationId         String?   @map("generation_id") @db.Uuid
  backupCounter        Int       @default(0) @map("backup_counter")
  prunedThroughOrdinal Int       @default(0) @map("pruned_through_ordinal")
  lastBackupId         String?   @map("last_backup_id") @db.Uuid
  lastBackupOrdinal    Int?      @map("last_backup_ordinal")
  lastBackupSnapshot   String?   @map("last_backup_snapshot")
  lastBackupAt         DateTime? @map("last_backup_at") @db.Timestamptz(6)
  lastPath             String?   @map("last_path")
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("backup_state")
}

model BackupChangeLog {
  seq       BigInt                  @id @default(autoincrement())
  txid      Unsupported("xid8")     @default(dbgenerated("pg_current_xact_id()"))
  tableName String                  @map("table_name")
  op        String                  @db.Char(1)
  pk        Json
  rowData   Json?                   @map("row_data")
  changedAt DateTime                @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@map("backup_change_log")
}

model BackupRun {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            String
  status          String
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  startedByUserId Int?      @map("started_by_user_id")
  targetPath      String?   @map("target_path")
  backupId        String?   @map("backup_id") @db.Uuid
  ordinal         Int?
  generationId    String?   @map("generation_id") @db.Uuid
  snapshot        String?
  rowCount        BigInt?   @map("row_count")
  fileCount       Int?      @map("file_count")
  bytes           BigInt?
  error           String?
  progress        Json?

  @@map("backup_runs")
}

// How each document type's number looks (settings › قالب شماره‌گذاری). One row per
// doc type that was customised; no row = the default PREFIX-<year>-000001.
// Counters live in DocumentSequence. Owned by the Numbering module.
model NumberingFormat {
  docType    String   @id @map("doc_type")
  prefix     String
  middleMode String   @map("middle_mode") // year | fixed | none
  middleText String?  @map("middle_text")
  separator  String   @default("-")
  digits     Int      @default(6)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("numbering_formats")
}
