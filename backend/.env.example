DATABASE_URL="postgresql://postgres:CHANGE_ME_LONG_RANDOM_PASSWORD@localhost:5432/business_system?schema=public"
PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string

# --- Security (see deploy/README.md) ---
# Listen address of the API. 127.0.0.1 = reachable only through the Next.js app / HTTPS proxy.
HOST=127.0.0.1
# Production: NODE_ENV=production makes SESSION_SECRET mandatory (>= 32 chars: openssl rand -hex 32).
# NODE_ENV=production
# Send the session cookie only over HTTPS (set to true once the HTTPS proxy is in place).
# SESSION_COOKIE_SECURE=true

# Backup / restore (admin panel «پشتیبان‌گیری»). Both are optional; the defaults are inside the backend folder.
# Safety copy taken automatically right before a restore:
# BACKUP_LOCAL_DIR=/var/dms/local-backups
# Where a backup for a drive on another computer is built before the browser copies it:
# BACKUP_STAGING_DIR=/var/dms/backup-staging
